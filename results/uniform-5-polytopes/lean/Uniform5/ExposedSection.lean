import Uniform5.SphereSection

open Set
open scoped RealInnerProductSpace

namespace Uniform5

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]


/-- A supporting-level condition is preserved by convex combinations, including
its equality case in any prescribed convex set. -/
lemma convex_support_imp (M : E →L[ℝ] ℝ) (m : ℝ) {C : Set E} (hC : Convex ℝ C) :
    Convex ℝ {x | M x ≤ m ∧ (M x = m → x ∈ C)} := by
  intro x hx y hy a d ha hd had
  simp only [mem_setOf_eq, map_add, map_smul, smul_eq_mul] at *
  have hab : a * m + d * m = m := by nlinarith [congrArg (fun t : ℝ => t * m) had]
  refine ⟨by nlinarith [mul_nonneg ha (sub_nonneg.mpr hx.1),
    mul_nonneg hd (sub_nonneg.mpr hy.1)], ?_⟩
  intro heq
  by_cases ha0 : a = 0
  · have hd1 : d = 1 := by linarith
    simpa [ha0, hd1] using hy.2 (by simpa [ha0, hd1] using heq)
  by_cases hd0 : d = 0
  · have ha1 : a = 1 := by linarith
    simpa [hd0, ha1] using hx.2 (by simpa [hd0, ha1] using heq)
  have hxEq : M x = m := by
    have hp : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
    nlinarith [mul_nonneg hd (sub_nonneg.mpr hy.1)]
  have hyEq : M y = m := by
    have hp : 0 < d := lt_of_le_of_ne hd (Ne.symm hd0)
    nlinarith [mul_nonneg ha (sub_nonneg.mpr hx.1)]
  exact hC (hx.2 hxEq) (hy.2 hyEq) ha hd had

/-- A nonempty exposed face is a supporting level through any of its points. -/
lemma exposed_support {P F : Set E} {v : E} (hF : IsExposed ℝ P F) (hv : v ∈ F) :
    ∃ M : E →L[ℝ] ℝ, (∀ x ∈ P, M x ≤ M v) ∧
      ∀ x, x ∈ F ↔ x ∈ P ∧ M x = M v := by
  obtain ⟨M, hM⟩ := hF ⟨v, hv⟩
  have hvm := hM ▸ hv
  refine ⟨M, hvm.2, ?_⟩
  intro x
  rw [hM]
  constructor
  · rintro ⟨hx, hmax⟩
    exact ⟨hx, le_antisymm (hvm.2 x hx) (hmax v hvm.1)⟩
  · rintro ⟨hx, heq⟩
    exact ⟨hx, fun y hy => heq ▸ hvm.2 y hy⟩

/-- Exposed faces of a hull are generated by the original generators they contain. -/
theorem exposedFace_eq_convexHull_inter (S : Set E) {F : Set E}
    (hF : IsExposed ℝ (convexHull ℝ S) F) : F = convexHull ℝ (S ∩ F) := by
  classical
  by_cases hn : F.Nonempty
  · obtain ⟨v, hv⟩ := hn
    obtain ⟨M, hbound, hmem⟩ := exposed_support hF hv
    apply le_antisymm
    · have hh : ∀ x ∈ convexHull ℝ S,
          M x ≤ M v ∧ (M x = M v → x ∈ convexHull ℝ (S ∩ F)) := by
        apply convexHull_min _ (convex_support_imp M (M v) (convex_convexHull ℝ _))
        intro x hx
        have hxP := subset_convexHull ℝ S hx
        exact ⟨hbound x hxP, fun heq => subset_convexHull ℝ _ ⟨hx, (hmem x).mpr ⟨hxP, heq⟩⟩⟩
      intro x hx
      exact (hh x ((hmem x).mp hx).1).2 ((hmem x).mp hx).2
    · exact convexHull_min inter_subset_right (hF.convex (convex_convexHull ℝ S))
  · rw [Set.not_nonempty_iff_eq_empty.mp hn]
    simp

/-- Restriction of an exposed face through the apex to a transverse section. -/
theorem exposedFace_inter_section {P F H : Set E} {v : E}
    (hF : IsExposed ℝ P F) (hv : v ∈ F) :
    IsExposed ℝ (P ∩ H) (F ∩ H) := by
  intro hn
  obtain ⟨z, hzF, hzH⟩ := hn
  obtain ⟨M, hbound, hmem⟩ := exposed_support hF hv
  refine ⟨M, ?_⟩
  ext y
  constructor
  · rintro ⟨hyF, hyH⟩
    obtain ⟨hyP, hyM⟩ := (hmem y).mp hyF
    exact ⟨⟨hyP, hyH⟩, fun x hx => hyM ▸ hbound x hx.1⟩
  · rintro ⟨⟨hyP, hyH⟩, hmax⟩
    have hz := (hmem z).mp hzF
    have hm := hmax z ⟨hz.1, hzH⟩
    rw [hz.2] at hm
    exact ⟨(hmem y).mpr ⟨hyP, le_antisymm (hbound y hyP) hm⟩, hyH⟩

/-- Positive ray parameters preserve membership in any exposed face through the apex. -/
lemma exposedFace_ray_iff {P F : Set E} {v x q : E}
    (hF : IsExposed ℝ P F) (hv : v ∈ F) (hxP : x ∈ P) (hqP : q ∈ P)
    {a : ℝ} (ha : 0 < a) (hrep : x = v + a • (q - v)) :
    x ∈ F ↔ q ∈ F := by
  obtain ⟨M, hbound, hmem⟩ := exposed_support hF hv
  have he : M x - M v = a * (M q - M v) := by
    conv_lhs => rw [hrep]
    simp only [map_add, map_smul, map_sub, smul_eq_mul]
    ring
  rw [hmem x, hmem q]
  constructor
  · rintro ⟨_, hh⟩
    exact ⟨hqP, by nlinarith⟩
  · rintro ⟨_, hh⟩
    exact ⟨hxP, by nlinarith⟩

variable [DecidableEq E]

/-- The section map reflects inclusion of exposed faces through the vertex. -/
theorem unit_edge_exposedFace_section_subset_iff (V : Finset E) {v : E} {R : ℝ}
    (hv : v ∈ V) (hsphere : ∀ x ∈ V, ‖x‖ = R)
    (hunit : ∀ x y, IsEdge V x y → dist x y = 1)
    {F G : Set E} (hF : IsExposed ℝ (convexHull ℝ (V : Set E)) F) (hvF : v ∈ F)
    (hG : IsExposed ℝ (convexHull ℝ (V : Set E)) G) (hvG : v ∈ G) :
    F ∩ figureHyperplane v R ⊆ G ∩ figureHyperplane v R ↔ F ⊆ G := by
  refine ⟨?_, fun h => Set.inter_subset_inter_left _ h⟩
  intro h
  rw [exposedFace_eq_convexHull_inter (V : Set E) hF]
  apply convexHull_min _ (hG.convex (convex_convexHull ℝ _))
  rintro x ⟨hxV, hxF⟩
  by_cases hxv : x = v
  · simpa [hxv] using hvG
  have hsep : ∀ x ∈ V, x ≠ v → 1 ≤ dist x v := by
    intro x hx hxv
    apply unit_edges_separated V (c := 0) (R := R) _ hunit hx hv hxv
    intro z hz
    simp [hsphere z hz]
  have hxe : x ∈ V.erase v := Finset.mem_erase.mpr ⟨hxv, hxV⟩
  obtain ⟨hqH, hqP, a, ha, hrep⟩ := sphericalRayPoint_data V hv hsphere hsep hxe
  have hxP := subset_convexHull ℝ (V : Set E) hxV
  have hqF := (exposedFace_ray_iff hF hvF hxP hqP ha hrep).mp hxF
  have hqG := (h ⟨hqF, hqH⟩).1
  exact (exposedFace_ray_iff hG hvG hxP hqP ha hrep).mpr hqG

/-- Every exposed face of the section lifts to a unique exposed face through
`v`. This includes the empty section face, whose lift is `{v}`. -/
theorem unit_edge_exposedFace_section_existsUnique (V : Finset E) {v : E} {R : ℝ}
    (hv : v ∈ V) (hsphere : ∀ x ∈ V, ‖x‖ = R)
    (hunit : ∀ x y, IsEdge V x y → dist x y = 1)
    {G : Set E} (hG : IsExposed ℝ
      (convexHull ℝ (V : Set E) ∩ figureHyperplane v R) G) :
    ∃! F : Set E, IsExposed ℝ (convexHull ℝ (V : Set E)) F ∧
      v ∈ F ∧ F ∩ figureHyperplane v R = G := by
  let P := convexHull ℝ (V : Set E)
  let H := figureHyperplane v R
  let L := innerSL ℝ v
  let b := R ^ 2 - 1 / 2
  have hLv : L v = R ^ 2 := by simp only [L, innerSL_apply, real_inner_self_eq_norm_sq, hsphere v hv]
  have hb : b < L v := by rw [hLv]; dsimp [b]; linarith
  have hvP : v ∈ P := subset_convexHull ℝ _ hv
  have hvH : v ∉ H := by
    change ¬ ⟪v, v⟫ = R ^ 2 - 1 / 2
    rw [real_inner_self_eq_norm_sq, hsphere v hv]
    linarith
  have hsep : ∀ x ∈ V, x ≠ v → 1 ≤ dist x v := by
    intro x hx hxv
    apply unit_edges_separated V (c := 0) (R := R) _ hunit hx hv hxv
    intro z hz
    simp [hsphere z hz]
  have hlevel : ∀ x ∈ V.erase v, L (sphericalRayPoint v x R) = b := by
    intro x hx
    have hh := (sphericalRayPoint_data V hv hsphere hsep hx).1
    simpa only [L, b, figureHyperplane, mem_setOf_eq, innerSL_apply,
      real_inner_comm v] using hh
  have hexists : ∃ F : Set E, IsExposed ℝ P F ∧ v ∈ F ∧ F ∩ H = G := by
    by_cases hn : G.Nonempty
    · obtain ⟨g, hg⟩ := hn
      obtain ⟨M, hbound, hmem⟩ := exposed_support hG hg
      let T := tiltFunctional M L v b (M g)
      have hTbound : ∀ x ∈ P, T x ≤ T v := by
        apply convexHull_min _ (convex_halfSpace_le (.mk T.map_add T.map_smul) (T v))
        intro x hx
        by_cases hxv : x = v
        · simp [hxv]
        have hxe : x ∈ V.erase v := Finset.mem_erase.mpr ⟨hxv, hx⟩
        obtain ⟨hqH, hqP, a, ha, hrep⟩ := sphericalRayPoint_data V hv hsphere hsep hxe
        have hh := hbound (sphericalRayPoint v x R) ⟨hqP, hqH⟩
        have he := tiltFunctional_level M L v (ne_of_lt hb) (hlevel x hxe) (m := M g)
        change T (sphericalRayPoint v x R) - T v = M (sphericalRayPoint v x R) - M g at he
        have hex : T x - T v = a * (T (sphericalRayPoint v x R) - T v) := by
          conv_lhs => rw [hrep]
          simp only [map_add, map_smul, map_sub, smul_eq_mul]
          ring
        rw [he] at hex
        change T x ≤ T v
        nlinarith [mul_nonpos_of_nonneg_of_nonpos ha.le (sub_nonpos.mpr hh)]
      let F := {x ∈ P | T x = T v}
      have hF : IsExposed ℝ P F := by
        intro _
        refine ⟨T, ?_⟩
        ext x
        constructor
        · rintro ⟨hx, he⟩
          exact ⟨hx, fun y hy => he ▸ hTbound y hy⟩
        · rintro ⟨hx, hmax⟩
          exact ⟨hx, le_antisymm (hTbound x hx) (hmax v hvP)⟩
      refine ⟨F, hF, ⟨hvP, rfl⟩, ?_⟩
      ext x
      have he (hx : x ∈ H) : T x - T v = M x - M g := by
        apply tiltFunctional_level M L v (ne_of_lt hb)
        simpa only [L, b, H, figureHyperplane, mem_setOf_eq, innerSL_apply,
          real_inner_comm v] using hx
      constructor
      · rintro ⟨⟨hxP, hxT⟩, hxH⟩
        exact (hmem x).mpr ⟨⟨hxP, hxH⟩, by linarith [he hxH]⟩
      · intro hx
        obtain ⟨⟨hxP, hxH⟩, hxM⟩ := (hmem x).mp hx
        exact ⟨⟨hxP, by linarith [he hxH]⟩, hxH⟩
    · have hGe : G = ∅ := Set.not_nonempty_iff_eq_empty.mp hn
      have hLstrict : ∀ x ∈ V, x ≠ v → L x < L v := by
        intro x hx hxv
        have hxsep := hsep x hx hxv
        have hch := sphere_chord_sq (hsphere x hx) (hsphere v hv)
        rw [dist_eq_norm] at hxsep
        simp only [L, innerSL_apply, real_inner_self_eq_norm_sq, hsphere v hv]
        rw [← real_inner_comm v x]
        nlinarith
      have hF : IsExposed ℝ P ({v} : Set E) := by
        have hh := exposes_segment hv hv L (L v) rfl rfl
          (fun x hx => by by_cases hxv : x = v; simp [hxv]; exact (hLstrict x hx hxv).le)
          (fun x hx he => by
            by_cases hxv : x = v
            · exact Or.inl hxv
            · exact False.elim ((ne_of_lt (hLstrict x hx hxv)) he))
        simpa only [segment_same] using hh
      refine ⟨{v}, hF, mem_singleton v, ?_⟩
      rw [hGe]
      exact Set.disjoint_iff_inter_eq_empty.mp (Set.disjoint_singleton_left.mpr hvH)
  obtain ⟨F, hF, hvF, hFG⟩ := hexists
  refine ⟨F, ⟨hF, hvF, hFG⟩, ?_⟩
  rintro K ⟨hK, hvK, hKG⟩
  apply Set.Subset.antisymm
  · apply (unit_edge_exposedFace_section_subset_iff V hv hsphere hunit hK hvK hF hvF).mp
    rw [hKG, hFG]
  · apply (unit_edge_exposedFace_section_subset_iff V hv hsphere hunit hF hvF hK hvK).mp
    rw [hKG, hFG]

variable [FiniteDimensional ℝ E]

omit [DecidableEq E] in
/-- Adding a point outside a set's affine span raises its dimension by one,
with natural-number truncation also covering the empty set. -/
lemma section_finrank_of_span_insert (S : Set E) (v : E)
    (hv : v ∉ affineSpan ℝ S) :
    Module.finrank ℝ (affineSpan ℝ S).direction =
      Module.finrank ℝ (affineSpan ℝ (insert v S)).direction - 1 := by
  by_cases hn : S.Nonempty
  · let A := affineSpan ℝ S
    let B := affineSpan ℝ (insert v S)
    have hAB : A ≤ B := affineSpan_mono ℝ (Set.subset_insert v S)
    have hvB : v ∈ B := subset_affineSpan ℝ _ (mem_insert v S)
    have hlt : A < B := lt_of_le_of_ne hAB (by
      intro hh
      have hhA : v ∈ A := hh.symm ▸ hvB
      exact hv hhA)
    have hAn : (A : Set E).Nonempty := hn.affineSpan ℝ
    have hdimlt := Submodule.finrank_lt_finrank_of_lt
      (AffineSubspace.direction_lt_of_nonempty hlt hAn)
    have hdimle := finrank_vectorSpan_insert_le_set ℝ S v
    rw [← direction_affineSpan, ← direction_affineSpan] at hdimle
    change Module.finrank ℝ B.direction ≤ Module.finrank ℝ A.direction + 1 at hdimle
    change Module.finrank ℝ A.direction = Module.finrank ℝ B.direction - 1
    omega
  · rw [Set.not_nonempty_iff_eq_empty.mp hn]
    rw [direction_affineSpan, direction_affineSpan, vectorSpan_empty,
      insert_empty_eq, vectorSpan_singleton]
    simp

/-- Dimension shift for every exposed face through the vertex. For a positive
`j`-dimensional face the section has dimension `j-1`. The singleton/empty pair
is also included using natural-number truncated dimension. -/
theorem unit_edge_exposedFace_section_finrank (V : Finset E) {v : E} {R : ℝ}
    (hv : v ∈ V) (hsphere : ∀ x ∈ V, ‖x‖ = R)
    (hunit : ∀ x y, IsEdge V x y → dist x y = 1)
    {F : Set E} (hF : IsExposed ℝ (convexHull ℝ (V : Set E)) F) (hvF : v ∈ F) :
    Module.finrank ℝ (affineSpan ℝ (F ∩ figureHyperplane v R)).direction =
      Module.finrank ℝ (affineSpan ℝ F).direction - 1 := by
  let S := F ∩ figureHyperplane v R
  have hvS : v ∉ affineSpan ℝ S := by
    have hAH : affineSpan ℝ S ≤ figureAffineHyperplane v R :=
      affineSpan_le_of_subset_coe (fun x hx => hx.2)
    intro hh
    have hh := hAH hh
    change ⟪v, v⟫ = R ^ 2 - 1 / 2 at hh
    rw [real_inner_self_eq_norm_sq, hsphere v hv] at hh
    linarith
  have hspan : affineSpan ℝ (insert v S) = affineSpan ℝ F := by
    apply le_antisymm
    · apply affineSpan_mono ℝ
      exact Set.insert_subset hvF inter_subset_left
    · rw [exposedFace_eq_convexHull_inter (V : Set E) hF, affineSpan_convexHull]
      apply affineSpan_le_of_subset_coe
      rintro x ⟨hxV, hxF⟩
      have hvB : v ∈ affineSpan ℝ (insert v S) := subset_affineSpan ℝ _ (mem_insert v S)
      by_cases hxv : x = v
      · simpa [hxv] using hvB
      have hsep : ∀ x ∈ V, x ≠ v → 1 ≤ dist x v := by
        intro x hx hxv
        apply unit_edges_separated V (c := 0) (R := R) _ hunit hx hv hxv
        intro z hz
        simp [hsphere z hz]
      have hxe : x ∈ V.erase v := Finset.mem_erase.mpr ⟨hxv, hxV⟩
      obtain ⟨hqH, hqP, a, ha, hrep⟩ := sphericalRayPoint_data V hv hsphere hsep hxe
      have hxP := subset_convexHull ℝ (V : Set E) hxV
      have hqF := (exposedFace_ray_iff hF hvF hxP hqP ha hrep).mp hxF
      have hqB : sphericalRayPoint v x R ∈ affineSpan ℝ (insert v S) :=
        subset_affineSpan ℝ _ (mem_insert_of_mem v ⟨hqF, hqH⟩)
      rw [hrep]
      simpa only [vsub_eq_sub, vadd_eq_add, add_comm] using
        (affineSpan ℝ (insert v S)).smul_vsub_vadd_mem a hqB hvB hvB
  exact (section_finrank_of_span_insert S v hvS).trans
    (congrArg (fun A : AffineSubspace ℝ E => Module.finrank ℝ A.direction - 1) hspan)

/-- The exposed-face version of the paper's vertex-figure face correspondence:
restriction, inclusion reflection, unique lifting, and dimension shift.
All these assertions are proved, rather than fields of an assumed model. -/
def ExposedVertexFigureCorrespondence (V : Finset E) (v : E) (R : ℝ) : Prop :=
  let P := convexHull ℝ (V : Set E)
  let H := figureHyperplane v R
  (∀ F, IsExposed ℝ P F → v ∈ F → IsExposed ℝ (P ∩ H) (F ∩ H)) ∧
  (∀ F G, IsExposed ℝ P F → v ∈ F → IsExposed ℝ P G → v ∈ G →
    (F ∩ H ⊆ G ∩ H ↔ F ⊆ G)) ∧
  (∀ G, IsExposed ℝ (P ∩ H) G →
    ∃! F, IsExposed ℝ P F ∧ v ∈ F ∧ F ∩ H = G) ∧
  (∀ F, IsExposed ℝ P F → v ∈ F →
    Module.finrank ℝ (affineSpan ℝ (F ∩ H)).direction =
      Module.finrank ℝ (affineSpan ℝ F).direction - 1)

theorem unit_edge_exposedVertexFigureCorrespondence (V : Finset E) {v : E} {R : ℝ}
    (hv : v ∈ V) (hsphere : ∀ x ∈ V, ‖x‖ = R)
    (hunit : ∀ x y, IsEdge V x y → dist x y = 1) :
    ExposedVertexFigureCorrespondence V v R := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro F hF hvF
    exact exposedFace_inter_section hF hvF
  · intro F G hF hvF hG hvG
    exact unit_edge_exposedFace_section_subset_iff V hv hsphere hunit hF hvF hG hvG
  · intro G hG
    exact unit_edge_exposedFace_section_existsUnique V hv hsphere hunit hG
  · intro F hF hvF
    exact unit_edge_exposedFace_section_finrank V hv hsphere hunit hF hvF

end Uniform5
