import CD13.Reduction

/-!
The Hecke–Kiselman word presentation used for the acyclic dynamics target.
These are exactly the Collina–D'Andrea relations
for a directed acyclic graph; the definition makes sense for any relation.
-/
namespace CD13.HK

variable {V : Type u}

/-- The least congruence generated by the stated HK relations. -/
inductive Rel (E : V → V → Prop) : List V → List V → Prop
  | refl (w) : Rel E w w
  | symm {u v} : Rel E u v → Rel E v u
  | trans {u v w} : Rel E u v → Rel E v w → Rel E u w
  | append {u v x y} : Rel E u v → Rel E x y → Rel E (u ++ x) (v ++ y)
  | idem (a) : Rel E [a, a] [a]
  | commute (a b) : a ≠ b → ¬ E a b → ¬ E b a → Rel E [a, b] [b, a]
  | triangleOut (a b) : E a b → Rel E [a, b, a] [a, b]
  | triangleIn (a b) : E a b → Rel E [b, a, b] [a, b]

/-- The actual presentation has a repeat-property representative for every word. -/
def ReducedRepresentativeEndpoint (E : V → V → Prop) : Prop :=
  ∀ w, ∃ v, Rel E w v ∧ Reduction.RepeatProperty E v ∧ v.length ≤ w.length

/-- Congruence packaged for the presentation-independent cancellation module. -/
def congruence (E : V → V → Prop) : Reduction.WordCongruence V where
  Rel := Rel E
  refl := Rel.refl
  symm := Rel.symm
  trans := Rel.trans
  append := Rel.append

 theorem relations (E : V → V → Prop) : Reduction.HKRelations (congruence E) E where
  idem := Rel.idem
  commute := Rel.commute
  triangleOut := Rel.triangleOut
  triangleIn := Rel.triangleIn

 theorem reduced_representative (E : V → V → Prop) (w : List V) :
    ∃ v, Rel E w v ∧ Reduction.RepeatProperty E v ∧ v.length ≤ w.length :=
  Reduction.reduce (congruence E) E (relations E) w

 theorem reducedRepresentativeEndpoint (E : V → V → Prop) :
    ReducedRepresentativeEndpoint E := reduced_representative E

/-- Any word evaluation satisfying the generators respects the presentation.
This explicitly certifies that no extra word identifications were inserted. -/
 theorem minimal (E : V → V → Prop) (C : Reduction.WordCongruence V)
    (H : Reduction.HKRelations C E) {u v : List V} (h : Rel E u v) : C.Rel u v := by
  induction h with
  | refl w => exact C.refl w
  | symm h ih => exact C.symm ih
  | trans h k ih ik => exact C.trans ih ik
  | append h k ih ik => exact C.append ih ik
  | idem a => exact H.idem a
  | commute a b h₁ h₂ h₃ => exact H.commute a b h₁ h₂ h₃
  | triangleOut a b h => exact H.triangleOut a b h
  | triangleIn a b h => exact H.triangleIn a b h

/-- The HK monoid's underlying set: words modulo exactly `Rel E`. -/
def setoid (E : V → V → Prop) : Setoid (List V) where
  r := Rel E
  iseqv := ⟨Rel.refl, Rel.symm, Rel.trans⟩

def Element (E : V → V → Prop) := Quotient (setoid E)

def ofWord (E : V → V → Prop) (w : List V) : Element E := Quotient.mk _ w

 theorem ofWord_eq_iff (E : V → V → Prop) (u v : List V) :
    ofWord E u = ofWord E v ↔ Rel E u v :=
  ⟨fun h => Quotient.exact h, fun h => Quotient.sound h⟩

/-- Word concatenation is the monoid multiplication. -/
def multiply (E : V → V → Prop) : Element E → Element E → Element E :=
  Quotient.lift₂ (fun u v => ofWord E (u ++ v))
    (fun _ _ _ _ h k => Quotient.sound (Rel.append h k))

def identity (E : V → V → Prop) : Element E := ofWord E []

 theorem multiply_word (E : V → V → Prop) (u v : List V) :
    multiply E (ofWord E u) (ofWord E v) = ofWord E (u ++ v) := rfl

 theorem multiply_assoc (E : V → V → Prop) (x y z : Element E) :
    multiply E (multiply E x y) z = multiply E x (multiply E y z) := by
  refine Quotient.inductionOn₃ x y z ?_
  intro u v w
  change ofWord E ((u ++ v) ++ w) = ofWord E (u ++ (v ++ w))
  rw [List.append_assoc]

 theorem identity_multiply (E : V → V → Prop) (x : Element E) :
    multiply E (identity E) x = x := by
  refine Quotient.inductionOn x ?_
  intro u
  rfl

 theorem multiply_identity (E : V → V → Prop) (x : Element E) :
    multiply E x (identity E) = x := by
  refine Quotient.inductionOn x ?_
  intro u
  change ofWord E (u ++ []) = ofWord E u
  rw [List.append_nil]

/-- Every relation-respecting evaluation descends to the actual quotient. -/
def factor (E : V → V → Prop) {S : Sort v} (f : List V → S)
    (h : ∀ u v, Rel E u v → f u = f v) : Element E → S :=
  Quotient.lift f h

 theorem factor_word (E : V → V → Prop) {S : Sort v} (f : List V → S)
    (h : ∀ u v, Rel E u v → f u = f v) (w : List V) :
    factor E f h (ofWord E w) = f w := rfl

 theorem factor_injective (E : V → V → Prop) {S : Sort v} (f : List V → S)
    (h : ∀ u v, Rel E u v → f u = f v)
    (sep : ∀ u v, f u = f v → Rel E u v) :
    Function.Injective (factor E f h) := by
  intro x y
  refine Quotient.inductionOn₂ x y ?_
  intro u v huv
  exact Quotient.sound (sep u v huv)

end CD13.HK
