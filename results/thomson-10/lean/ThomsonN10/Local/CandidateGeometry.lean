/- Candidate-specific finite distance classes, generated by geometry_export.py.
 The local-proof design follows proof/lean/ThomsonN9/CandidateEnergy.lean and
 LocalStationarity.lean, aravindkarthigeyan/thomson-n9-lean @
 168ff0c98cab4dfda0460ba55f8d169070ac385e (MIT). -/
import ThomsonN10.Data
namespace ThomsonN10.Local

theorem height_bounds (h : CandidateParameter) : (42/100 : ℝ) ≤ h ∧ (h : ℝ) ≤ 43/100 := by
  constructor
  · exact le_trans (by norm_num [heightLower]) h.property.1
  · exact le_trans h.property.2.1 (by norm_num [heightUpper])

theorem candidate_radical_identities (h : ℝ) (hh : |h| ≤ 1) :
    (rho h)^2 = 1-h^2 ∧ (q h)^2 = (1-h^2)/2 ∧
      rho h*q h = (1-h^2)*Real.sqrt 2/2 := by
  have hr : (rho h)^2 = 1-h^2 := by
    apply Real.sq_sqrt
    nlinarith [sq_abs h, (abs_le.mp hh).1, (abs_le.mp hh).2]
  have hs : (Real.sqrt 2)^2 = (2 : ℝ) := Real.sq_sqrt (by norm_num)
  refine ⟨hr, ?_, ?_⟩
  · dsimp [q]
    rw [div_pow, mul_pow, hr, hs]
    ring
  · dsimp [q]
    calc
      _ = (rho h)^2*Real.sqrt 2/2 := by ring
      _ = _ := by rw [hr]

def pairClass : Fin 10 → Fin 10 → Fin 8 := ![![0,1,2,2,2,2,3,3,3,3],![1,0,3,3,3,3,2,2,2,2],![2,3,0,4,5,4,6,7,7,6],![2,3,4,0,4,5,6,6,7,7],![2,3,5,4,0,4,7,6,6,7],![2,3,4,5,4,0,7,7,6,6],![3,2,6,6,7,7,0,4,5,4],![3,2,7,6,6,7,4,0,4,5],![3,2,7,7,6,6,5,4,0,4],![3,2,6,7,7,6,4,5,4,0]]
noncomputable def pairSq (h : ℝ) : Fin 8 → ℝ :=
  ![0,4,2-2*h,2+2*h,2*(1-h^2),4*(1-h^2),
    2-Real.sqrt 2+(2+Real.sqrt 2)*h^2,
    2+Real.sqrt 2+(2-Real.sqrt 2)*h^2]

set_option maxHeartbeats 2000000 in
theorem candidate_distance_sq (h : ℝ) (hh : |h| ≤ 1) (i j : Fin 10) :
    ‖candidateAt h i-candidateAt h j‖^2 = pairSq h (pairClass i j) := by
  obtain ⟨hr,hq,hrq⟩ := candidate_radical_identities h hh
  fin_cases i <;> fin_cases j <;>
    simp [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_three, candidateAt, vec,
      pairSq, pairClass, PiLp.sub_apply] <;> nlinarith

theorem candidate_unit (h : CandidateParameter) (i : Fin 10) : ‖candidate h i‖ = 1 := by
  obtain ⟨hl,hu⟩ := height_bounds h
  have hh : |(h : ℝ)| ≤ 1 := abs_le.mpr ⟨by linarith, by linarith⟩
  obtain ⟨hr,hq,hrq⟩ := candidate_radical_identities h hh
  have hn : ‖candidate h i‖^2 = 1 := by
    change ‖candidateAt h i‖^2 = 1
    fin_cases i <;> simp [candidateAt, vec_norm_sq] <;> nlinarith
  nlinarith [norm_nonneg (candidate h i)]

theorem candidate_pair_distance_ge_one (h : CandidateParameter) {i j : Fin 10}
    (hij : i ≠ j) : 1 ≤ ‖candidate h i-candidate h j‖ := by
  obtain ⟨hl,hu⟩ := height_bounds h
  have hh : |(h : ℝ)| ≤ 1 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hclass : pairClass i j ≠ 0 := by revert i j; decide
  have hs : (Real.sqrt 2)^2 = (2 : ℝ) := Real.sq_sqrt (by norm_num)
  have hsl : (1 : ℝ) ≤ Real.sqrt 2 := by nlinarith [Real.sqrt_nonneg (2 : ℝ)]
  have hsu : Real.sqrt 2 ≤ (3/2 : ℝ) := by nlinarith [Real.sqrt_nonneg (2 : ℝ)]
  have hlow : (42/100 : ℝ)^2 ≤ (h : ℝ)^2 := by nlinarith
  have hcross : 0 ≤ (Real.sqrt 2-1)*(h : ℝ)^2 := mul_nonneg (by linarith) (sq_nonneg _)
  have hfar : 0 ≤ (2-Real.sqrt 2)*(h : ℝ)^2 := mul_nonneg (by linarith) (sq_nonneg _)
  have hsq := candidate_distance_sq h hh i j
  change ‖candidate h i-candidate h j‖^2 = _ at hsq
  have hc : (1 : ℝ) ≤ pairSq h (pairClass i j) := by
    generalize pairClass i j = k at *
    fin_cases k <;> simp [pairSq] at * <;> nlinarith
  nlinarith [norm_nonneg (candidate h i-candidate h j)]

theorem candidate_distance (h : CandidateParameter) (i j : Fin 10) :
    ‖candidate h i-candidate h j‖ = Real.sqrt (pairSq h (pairClass i j)) := by
  obtain ⟨hl,hu⟩ := height_bounds h
  have hh : |(h : ℝ)| ≤ 1 := abs_le.mpr ⟨by linarith, by linarith⟩
  rw [← candidate_distance_sq h hh i j, Real.sqrt_sq (norm_nonneg _)]
  rfl

end ThomsonN10.Local
