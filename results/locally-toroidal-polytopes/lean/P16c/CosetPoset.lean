import Mathlib
import P16c.StringC
import P16c.StringCTheory

/-! # The coset poset `P(Γ)` of a string C-group (ARP §2E)

A string C-group of rank `n` (ARP §2E) is a group `Γ = ⟨ρ_0, …, ρ_{n-1}⟩`
generated by involutions satisfying the string relations and the intersection
property. Here `Γ` is the subgroup `group` of an ambient group `G` generated by
the `ρ i`. Faces of type `k ∈ {0, …, n+1}` (rank `k - 1`) are the left cosets
`x Γ_k`, `x ∈ Γ`, of `Γ_k = ⟨ρ_i : i + 1 ≠ k⟩`; so `Γ_0 = Γ_{n+1} = Γ`
(ARP's convention for `F_{-1}` and `F_n`). A face of type `j` is below one of
type `k` iff `j ≤ k` and the cosets meet. ARP uses right cosets; left cosets
give the isomorphic poset under `x ↦ x⁻¹`. -/

namespace P16c

open scoped Pointwise

/-- A string C-group of rank `n` inside `G`: its distinguished generators. -/
structure StringCGroup (G : Type*) [Group G] (n : ℕ) where
  ρ : Fin n → G
  stringC : IsStringCGroup ρ
  ne_one : ∀ i, ρ i ≠ 1

namespace StringCGroup

variable {G : Type*} [Group G] {n : ℕ} (Γ : StringCGroup G n)

/-- The C-group `Γ = ⟨ρ_0, …, ρ_{n-1}⟩`. -/
def group : Subgroup G := parabolic Γ.ρ Finset.univ

/-- `Γ_k = ⟨ρ_i : i + 1 ≠ k⟩`, the stabilizer of the base face of type `k`. -/
def sub (k : Fin (n + 2)) : Subgroup G :=
  parabolic Γ.ρ (Finset.univ.filter fun i : Fin n => i.val + 1 ≠ k.val)

/-- The faces of `P(Γ)`: a type `k` and a left coset `x Γ_k` with `x ∈ Γ`. -/
def Face := {p : Fin (n + 2) × Set G // ∃ x ∈ Γ.group, p.2 = x • (Γ.sub p.1 : Set G)}

/-! ### Two factorization lemmas from the string relations -/

lemma rho_sq (i : Fin n) : Γ.ρ i ^ 2 = 1 := Γ.stringC.1 i

lemma commute_rho {i j : Fin n} (h : i.val + 2 ≤ j.val ∨ j.val + 2 ≤ i.val) :
    Commute (Γ.ρ i) (Γ.ρ j) := by
  rcases h with h | h
  · exact commute_of_involutions (Γ.rho_sq i) (Γ.rho_sq j) (Γ.stringC.2.1 i j h)
  · exact (commute_of_involutions (Γ.rho_sq j) (Γ.rho_sq i) (Γ.stringC.2.1 j i h)).symm

/-- If the generators indexed by `A` commute with those indexed by `B`, every
element of `⟨ρ_i : i ∈ A ∪ B⟩` is `a * b` with commuting factors. -/
lemma mem_union_factor {A B : Finset (Fin n)}
    (hc : ∀ i ∈ A, ∀ j ∈ B, Commute (Γ.ρ i) (Γ.ρ j)) {x : G}
    (hx : x ∈ parabolic Γ.ρ (A ∪ B)) :
    ∃ a ∈ parabolic Γ.ρ A, ∃ b ∈ parabolic Γ.ρ B, x = a * b ∧ a * b = b * a := by
  rw [parabolic_union] at hx
  have hcen := parabolic_le_centralizer Γ.ρ A B hc
  obtain ⟨a, ha, b, hb, rfl⟩ := mem_sup_factor hcen hx
  exact ⟨a, ha, b, hb, rfl, (Subgroup.mem_centralizer_iff.mp (hcen ha) b hb).symm⟩

/-- `Γ_k = ⟨ρ_i : i + 1 < k⟩ ⟨ρ_i : i + 1 > k⟩`, the factors commuting. -/
lemma sub_factor {k : Fin (n + 2)} {x : G} (hx : x ∈ Γ.sub k) :
    ∃ a ∈ parabolic Γ.ρ (Finset.univ.filter fun i : Fin n => i.val + 1 < k.val),
    ∃ b ∈ parabolic Γ.ρ (Finset.univ.filter fun i : Fin n => k.val < i.val + 1),
      x = a * b ∧ a * b = b * a := by
  apply Γ.mem_union_factor
  · intro i hi j hj
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi hj
    exact Γ.commute_rho (Or.inl (by omega))
  · have : (Finset.univ.filter fun i : Fin n => i.val + 1 ≠ k.val) =
        (Finset.univ.filter fun i : Fin n => i.val + 1 < k.val) ∪
          (Finset.univ.filter fun i : Fin n => k.val < i.val + 1) := by
      ext i; simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_union]; omega
    rw [← this]; exact hx

lemma parabolic_le_sub {k : Fin (n + 2)} {A : Finset (Fin n)}
    (h : ∀ i ∈ A, i.val + 1 ≠ k.val) : parabolic Γ.ρ A ≤ Γ.sub k := by
  apply parabolic_mono
  intro i hi
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact h i hi

lemma parabolic_le_group (A : Finset (Fin n)) : parabolic Γ.ρ A ≤ Γ.group :=
  parabolic_mono _ (Finset.subset_univ A)

lemma sub_le_group (k : Fin (n + 2)) : Γ.sub k ≤ Γ.group := Γ.parabolic_le_group _

/-! ### The partial order -/

lemma coset_eq_of_mem {H : Subgroup G} {x w : G} (hw : w ∈ x • (H : Set G)) :
    x • (H : Set G) = w • (H : Set G) :=
  (leftCoset_eq_iff H).mpr ((mem_leftCoset_iff x).mp hw)

/-- Transitivity of incidence (string relations only). -/
lemma incidence_trans {j k l : Fin (n + 2)} (hjk : j ≤ k) (hkl : k ≤ l) {x y z : G}
    (h1 : (x • (Γ.sub j : Set G) ∩ y • (Γ.sub k : Set G)).Nonempty)
    (h2 : (y • (Γ.sub k : Set G) ∩ z • (Γ.sub l : Set G)).Nonempty) :
    (x • (Γ.sub j : Set G) ∩ z • (Γ.sub l : Set G)).Nonempty := by
  obtain ⟨w1, hw1x, hw1y⟩ := h1
  obtain ⟨w2, hw2y, hw2z⟩ := h2
  have hy1 := coset_eq_of_mem hw1y
  have hy2 := coset_eq_of_mem hw2y
  have h12 : w1⁻¹ * w2 ∈ Γ.sub k := (leftCoset_eq_iff _).mp (hy1.symm.trans hy2)
  obtain ⟨a, ha, b, hb, hab, hcomm⟩ := Γ.sub_factor h12
  have haL : a ∈ Γ.sub l := Γ.parabolic_le_sub (by
    intro i hi; simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi; omega) ha
  have hbJ : b ∈ Γ.sub j := Γ.parabolic_le_sub (by
    intro i hi; simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi
    have := Fin.le_iff_val_le_val.mp hjk; omega) hb
  refine ⟨w1 * b, ?_, ?_⟩
  · rw [coset_eq_of_mem hw1x, mem_leftCoset_iff]; simpa using hbJ
  · rw [coset_eq_of_mem hw2z, mem_leftCoset_iff]
    have hw2 : w2 = w1 * (b * a) := by rw [← hcomm, ← hab]; group
    rw [hw2]
    have : (w1 * (b * a))⁻¹ * (w1 * b) = a⁻¹ := by group
    rw [this]; exact Subgroup.inv_mem _ haL

instance : PartialOrder Γ.Face where
  le F H := F.1.1 ≤ H.1.1 ∧ (F.1.2 ∩ H.1.2).Nonempty
  le_refl F := by
    obtain ⟨x, -, hx⟩ := F.2
    refine ⟨le_rfl, x, ?_⟩
    have : x ∈ F.1.2 := by rw [hx, mem_leftCoset_iff]; simp
    exact ⟨this, this⟩
  le_trans F H K hFH hHK := by
    obtain ⟨x, -, hx⟩ := F.2
    obtain ⟨y, -, hy⟩ := H.2
    obtain ⟨z, -, hz⟩ := K.2
    refine ⟨hFH.1.trans hHK.1, ?_⟩
    have h1 := hFH.2; have h2 := hHK.2
    rw [hx, hy] at h1; rw [hy, hz] at h2; rw [hx, hz]
    exact Γ.incidence_trans hFH.1 hHK.1 h1 h2
  le_antisymm F H hFH hHF := by
    obtain ⟨x, -, hx⟩ := F.2
    obtain ⟨y, -, hy⟩ := H.2
    have hk : F.1.1 = H.1.1 := le_antisymm hFH.1 hHF.1
    obtain ⟨w, hwF, hwH⟩ := hFH.2
    apply Subtype.ext
    apply Prod.ext hk
    rw [hx, hy] at *
    rw [hk] at hwF ⊢
    exact (coset_eq_of_mem hwF).trans (coset_eq_of_mem hwH).symm

/-- The rank of a face of type `k` is `k - 1`. -/
def rank (F : Γ.Face) : ℤ := (F.1.1.val : ℤ) - 1

/-- The face `x Γ_k` of type `k`. -/
def face (k : Fin (n + 2)) {x : G} (hx : x ∈ Γ.group) : Γ.Face :=
  ⟨(k, x • (Γ.sub k : Set G)), x, hx, rfl⟩

end StringCGroup

end P16c
