import Uniform5.CompositionVertices
import Mathlib.Data.Set.Finite.Powerset

/-!
# Genuine faces of finite polytopes

A convex extreme subset of a convex hull is generated by the generators
which it contains. This proves finiteness and vertex incidence for actual
geometric faces, without any face-encoding premise.
-/

noncomputable section

namespace Uniform5.Composition

open Set

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- A face is generated by precisely those original generators it contains.
No closedness or exposed-face assumption is needed. -/
theorem face_convexHull_eq {S F : Set E}
    (hF : IsConvexFace (convexHull ℝ S) F) :
    F = convexHull ℝ (S ∩ F) := by
  let T : Set E := {x | x ∈ convexHull ℝ S ∧
    (x ∈ F → x ∈ convexHull ℝ (S ∩ F))}
  have hST : S ⊆ T := by
    intro x hx
    exact ⟨subset_convexHull ℝ S hx,
      fun hxF => subset_convexHull ℝ (S ∩ F) ⟨hx, hxF⟩⟩
  have hT : Convex ℝ T := by
    apply convex_iff_openSegment_subset.mpr
    intro x hx y hy z hz
    refine ⟨(convex_convexHull ℝ S).openSegment_subset hx.1 hy.1 hz, ?_⟩
    intro hzF
    have hxy := hF.2.2 hx.1 hy.1 hzF hz
    exact (convex_convexHull ℝ (S ∩ F)).openSegment_subset
      (hx.2 hxy.1) (hy.2 hxy.2) hz
  apply Set.Subset.antisymm
  · intro x hx
    exact (convexHull_min hST hT (hF.2.1 hx)).2 hx
  · exact convexHull_min inter_subset_right hF.1

/-- Every nonempty geometric face of a finite polytope is a finite polytope. -/
theorem finitePolytope_face {P F : Set E} (hP : FinitePolytope P)
    (hF : IsConvexFace P F) (hne : F.Nonempty) : FinitePolytope F := by
  classical
  obtain ⟨V, _, rfl⟩ := hP
  have hfin : ((V : Set E) ∩ F).Finite := V.finite_toSet.inter_of_left F
  have heq := face_convexHull_eq hF
  refine ⟨hfin.toFinset, ?_, ?_⟩
  · apply hfin.toFinset_nonempty.mpr
    apply (convexHull_nonempty_iff (𝕜 := ℝ)).mp
    rwa [← heq]
  · simpa only [Set.Finite.coe_toFinset] using heq

/-- The actual vertices of a face are exactly the incident ambient vertices. -/
theorem face_extremePoints_eq {P F : Set E} (hF : IsConvexFace P F) :
    F.extremePoints ℝ = F ∩ P.extremePoints ℝ :=
  hF.2.extremePoints_eq

/-- Finite-polytope faces are the hulls of the ambient vertices they contain,
including the empty face. -/
theorem face_eq_convexHull_vertices {P F : Set E} (hP : FinitePolytope P)
    (hF : IsConvexFace P F) :
    F = convexHull ℝ (P.extremePoints ℝ ∩ F) := by
  apply face_convexHull_eq
  rwa [← finitePolytope_eq_convexHull_extremePoints hP]

/-- A genuine face is uniquely determined by its incident actual vertices. -/
theorem face_eq_of_vertices_eq {P F G : Set E} (hP : FinitePolytope P)
    (hF : IsConvexFace P F) (hG : IsConvexFace P G)
    (hvertices : P.extremePoints ℝ ∩ F = P.extremePoints ℝ ∩ G) : F = G := by
  rw [face_eq_convexHull_vertices hP hF, face_eq_convexHull_vertices hP hG, hvertices]

/-- A finite polytope has finitely many geometric faces, including its empty
and improper faces. The proof injects faces into subsets of actual vertices. -/
theorem finitePolytope_faces_finite {P : Set E} (hP : FinitePolytope P) :
    {F : Set E | IsConvexFace P F}.Finite := by
  let f : Set E → Set E := fun F => P.extremePoints ℝ ∩ F
  have hfinite : (f '' {F : Set E | IsConvexFace P F}).Finite := by
    apply (finitePolytope_extremePoints_finite hP).powerset.subset
    rintro _ ⟨F, _, rfl⟩
    exact inter_subset_left
  apply hfinite.of_finite_image
  intro F hF G hG hFG
  exact face_eq_of_vertices_eq hP hF hG hFG

/-- Nonempty geometric facets inherit finiteness directly from their parent. -/
theorem finitePolytope_facet {P F : Set E} (hP : FinitePolytope P)
    (hF : Facet P F) : FinitePolytope F :=
  finitePolytope_face hP hF.1 hF.2.1

/-- Sanity check: the whole convex polytope is one of its geometric faces. -/
theorem finitePolytope_self_face {P : Set E} (hP : FinitePolytope P) :
    IsConvexFace P P := ⟨finitePolytope_convex hP, IsExtreme.refl ℝ P⟩

/-- Sanity check: a singleton face is precisely an actual extreme point. -/
theorem singleton_face_iff_extremePoint (P : Set E) (v : E) :
    IsConvexFace P {v} ↔ v ∈ P.extremePoints ℝ := by
  simp only [IsConvexFace, convex_singleton, true_and, isExtreme_singleton]

/-- Actual geometric faces, ordered by inclusion of their underlying sets. -/
noncomputable def GeometricFace (P : Set E) := {F : Set E // IsConvexFace P F}

noncomputable instance (P : Set E) : PartialOrder (GeometricFace P) :=
  inferInstanceAs (PartialOrder {F : Set E // IsConvexFace P F})

/-- The actual face type of a finite polytope is finite. -/
theorem finite_geometricFace {P : Set E} (hP : FinitePolytope P) :
    Finite (GeometricFace P) := (finitePolytope_faces_finite hP).to_subtype

/-- A face's own geometric face poset is exactly the interval of ambient
faces contained in it. Both directions use the actual extreme-subset laws. -/
noncomputable def geometricFace_lowerEquiv {P F : Set E}
    (hF : IsConvexFace P F) :
    GeometricFace F ≃o {G : GeometricFace P // G.val ⊆ F} where
  toFun G := ⟨⟨G.val, face_of_face hF G.property⟩, G.property.2.1⟩
  invFun G := ⟨G.val.val, face_restrict G.val.property hF.2.1 G.property⟩
  left_inv G := rfl
  right_inv G := rfl
  map_rel_iff' := by intros; rfl

/-- Every actual vertex of a finite convex hull admits a continuous linear
functional strictly larger there than at each other generator. -/
theorem finite_extreme_strict_support (S : Finset E) {y : E}
    (hy : y ∈ (convexHull ℝ (S : Set E)).extremePoints ℝ) :
    ∃ L : E →L[ℝ] ℝ, ∀ x ∈ S, x ≠ y → L x < L y := by
  classical
  have hyout : y ∉ convexHull ℝ ((S.erase y : Finset E) : Set E) := by
    have hychar := (convex_convexHull ℝ (S : Set E)).mem_extremePoints_iff_mem_diff_convexHull_diff.mp hy
    intro hin
    apply hychar.2
    apply convexHull_mono (t := convexHull ℝ (S : Set E) \ {y}) ?_ hin
    intro x hx
    have hx' := Finset.mem_erase.mp hx
    exact ⟨subset_convexHull ℝ (S : Set E) hx'.2, hx'.1⟩
  obtain ⟨L, b, hL, hby⟩ := geometric_hahn_banach_closed_point
    (convex_convexHull ℝ ((S.erase y : Finset E) : Set E))
    (S.erase y).finite_toSet.isCompact_convexHull.isClosed hyout
  refine ⟨L, ?_⟩
  intro x hx hxy
  exact (hL x (subset_convexHull ℝ _ (Finset.mem_erase.mpr ⟨hxy, hx⟩))).trans hby

/-- Every actual vertex of a finite polytope is an exposed singleton. -/
theorem finitePolytope_extreme_isExposed {P : Set E} (hP : FinitePolytope P)
    {y : E} (hy : y ∈ P.extremePoints ℝ) : IsExposed ℝ P {y} := by
  classical
  obtain ⟨S, _, rfl⟩ := hP
  have hyS : y ∈ S := extremePoints_convexHull_subset hy
  obtain ⟨L, hL⟩ := finite_extreme_strict_support S hy
  have hseg := exposes_segment (S := (S : Set E)) hyS hyS L (L y) rfl rfl
    (fun x hx => by
      by_cases hxy : x = y
      · simp [hxy]
      · exact (hL x hx hxy).le)
    (fun x hx heq => by
      by_cases hxy : x = y
      · exact Or.inl hxy
      · exact False.elim ((ne_of_lt (hL x hx hxy)) heq))
  simpa only [segment_same] using hseg

end Uniform5.Composition
