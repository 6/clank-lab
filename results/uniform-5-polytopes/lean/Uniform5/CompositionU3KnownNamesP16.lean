theorem u3KnownNamesByRowP16_source_names :
    u3KnownNamesByRowP16.map (List.map KnownFiveName.sourceName) =
      u3ReportP16.map U3ReportRow.known_names := by decide

/-- Every reported name has its literal geometric construction meaning. -/
theorem u3ReportP16_name_interpreted {r : U3ReportRow} (hr : r ∈ u3ReportP16)
    {s : String} (hs : s ∈ r.known_names) :
    ∃ n : KnownFiveName, n.sourceName = s := by
  have hm : r.known_names ∈ u3ReportP16.map U3ReportRow.known_names :=
    List.mem_map.mpr ⟨r, hr, rfl⟩
  rw [← u3KnownNamesByRowP16_source_names] at hm
  obtain ⟨ns, _, he⟩ := List.mem_map.mp hm
  rw [← he] at hs
  obtain ⟨n, _, hn⟩ := List.mem_map.mp hs
  exact ⟨n, hn⟩

/-- KNOWN rows carry a concrete name; this finite fact is not a premise. -/
theorem u3ReportP16_known_named {r : U3ReportRow} (hr : r ∈ u3ReportP16)
    (hk : r.verdict = .known) : ∃ n : KnownFiveName, n.sourceName ∈ r.known_names := by
  have hall : u3ReportP16.all (fun s => s.verdict != .known || !s.known_names.isEmpty) =
      true := by decide
  have hh := List.all_eq_true.mp hall r hr
  obtain ⟨s, hs⟩ : ∃ s, s ∈ r.known_names := by
    cases hn : r.known_names with
    | nil => simp [hk, hn] at hh
    | cons s rest => exact ⟨s, by simp [hn]⟩
  obtain ⟨n, hn⟩ := u3ReportP16_name_interpreted hr hs
  exact ⟨n, hn.symm ▸ hs⟩

