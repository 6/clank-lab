/-
Statement of Davis–Lelièvre Conjecture 4.3 (existence part) in the Kontorovich–Zhang
parametrization. Core Lean only; no Mathlib.
-/
namespace Pentagon

/-- `p + q φ`, φ the golden ratio (φ² = φ + 1), with natural-number coefficients. Every entry
of the generators below, and so every vector of the orbit of (0, 1), has this form. -/
structure ZPhi where
  p : Nat
  q : Nat
deriving DecidableEq, Repr

instance : Add ZPhi := ⟨fun x y => ⟨x.p + y.p, x.q + y.q⟩⟩
/-- (p + qφ)(r + sφ) = pr + qs + (ps + qr + qs)φ, using φ² = φ + 1. -/
instance : Mul ZPhi := ⟨fun x y => ⟨x.p * y.p + x.q * y.q, x.p * y.q + x.q * y.p + x.q * y.q⟩⟩

def ZPhi.zero : ZPhi := ⟨0, 0⟩
def ZPhi.one : ZPhi := ⟨1, 0⟩
def ZPhi.phi : ZPhi := ⟨0, 1⟩

/-- A column vector (x, y) = (a + bφ, c + dφ). -/
structure Vec where
  x : ZPhi
  y : ZPhi
deriving DecidableEq, Repr

/-- The 2 × 2 matrix [[e11, e12], [e21, e22]]. -/
structure Mat where
  e11 : ZPhi
  e12 : ZPhi
  e21 : ZPhi
  e22 : ZPhi

def Mat.act (M : Mat) (v : Vec) : Vec :=
  ⟨M.e11 * v.x + M.e12 * v.y, M.e21 * v.x + M.e22 * v.y⟩

open ZPhi

/-- Kontorovich–Zhang's generators of the Hecke-5 semigroup Γ⁺:
A = [[1, φ], [0, 1]], B = [[1, 0], [φ, 1]], C = [[φ, φ], [1, φ]], D = [[φ, 1], [φ, φ]]. -/
def A : Mat := ⟨one, phi, zero, one⟩
def B : Mat := ⟨one, zero, phi, one⟩
def C : Mat := ⟨phi, phi, one, phi⟩
def D : Mat := ⟨phi, one, phi, phi⟩

/-- Γ⁺ · (0, 1)ᵗ: the orbit of (0, 1) under the semigroup generated by A, B, C, D. -/
inductive Orbit : Vec → Prop
  | base : Orbit ⟨zero, one⟩
  | step {M : Mat} {v : Vec} : M ∈ [A, B, C, D] → Orbit v → Orbit (M.act v)

/-- ℓ = a + b + c + d for (a + bφ, c + dφ). -/
def ell (v : Vec) : Nat := v.x.p + v.x.q + v.y.p + v.y.q

/-- The asymmetry criterion (d − b) + 2(c − a) ≡ 0 (mod 5). -/
def Asym (v : Vec) : Prop :=
  (((v.y.q : Int) - v.x.q) + 2 * ((v.y.p : Int) - v.x.p)) % 5 = 0

/-- φ · v, the holonomy of the second trajectory in v's direction (Davis–Lelièvre Thm 3.16 call
the φv trajectory the long one, of combinatorial period 2(a + 2b + c + 2d) in the double
pentagon). Used only in `exceptions_combinatorial`, not in the main theorem. -/
def phiMul (v : Vec) : Vec := ⟨phi * v.x, phi * v.y⟩

/-- `AsymPeriod n`: some asymmetric periodic billiard trajectory in the regular pentagon has
combinatorial period `n`. Billiards are not formalized; this predicate enters only through the
cited theorem below and the hypothesis of the main theorem. -/
opaque AsymPeriod : Nat → Prop

/-- Cited input. Kontorovich–Zhang, "On the local-global conjecture for combinatorial period
lengths of closed billiards on the regular pentagon", IMRN 2025 (arXiv:2409.10682), §2. Its
hypothesis is discharged by their identification, stated just before the theorem: "Each periodic
direction in the golden L has a short and long saddle connection, and all long saddle
connections with directions in the first quadrant are given by ΛL = Γ+ · (0, 1)t." So every
`Orbit` vector is a long saddle connection. Theorem 2.1, citing Davis–Fuchs–Tabachnikov,
Mosc. Math. J. 11 (2011), Theorem 11:
"Given a long saddle connection (a + bϕ, c + dϕ) ∈ Γ+ · (0, 1)t in the golden L, let
ℓ = a + b + c + d. The combinatorial period of the corresponding pentagon billiard trajectory is
given either by L = 2ℓ or L = 10ℓ, depending on whether (d − b) + 2(c − a) ≡ 0 (mod 5) or not
(resp.), and corresponding to whether the associated trajectory is asymmetric or not."
Only the first case is used; "combinatorial period" is the least period. -/
axiom kz_thm_2_1 : ∀ v : Vec, Orbit v → Asym v → AsymPeriod (2 * ell v)

end Pentagon
