import P16c.GroupPresentation
import P16c.ToroidBridge

namespace P16c.Universal

lemma relations (s u : ℕ) :
    (∀ i, r s u i ^ 2 = 1) ∧ (r s u 0 * r s u 1) ^ 4 = 1 ∧
    (r s u 1 * r s u 2) ^ 4 = 1 ∧ (r s u 2 * r s u 3) ^ 4 = 1 ∧
    (r s u 0 * r s u 2) ^ 2 = 1 ∧ (r s u 0 * r s u 3) ^ 2 = 1 ∧
    (r s u 1 * r s u 3) ^ 2 = 1 ∧
    (r s u 0 * r s u 1 * r s u 2 * r s u 1) ^ s = 1 ∧
    (r s u 1 * r s u 2 * r s u 3 * r s u 2) ^ u = 1 := by
  refine ⟨fun i => ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [r]
  · exact PresentedGroup.one_of_mem (Or.inl ⟨i, rfl⟩)
  all_goals apply PresentedGroup.one_of_mem; simp [rels]

lemma string_relations (s u : ℕ) :
    (∀ i, r s u i ^ 2 = 1) ∧
      ∀ i j : Fin 4, i.val + 2 ≤ j.val → (r s u i * r s u j) ^ 2 = 1 := by
  have h := relations s u
  refine ⟨h.1, ?_⟩
  intro i j hij
  fin_cases i <;> fin_cases j <;> norm_num at hij
  all_goals first | exact h.2.2.2.2.1 | exact h.2.2.2.2.2.1 | exact h.2.2.2.2.2.2.1

section Maps
variable {H : Type*} [Group H]

/-- The universal map associated to the displayed defining relations. -/
def toGroup (s u : ℕ) (f : Fin 4 → H) (hi : ∀ i, f i ^ 2 = 1)
    (h01 : (f 0 * f 1) ^ 4 = 1) (h12 : (f 1 * f 2) ^ 4 = 1)
    (h23 : (f 2 * f 3) ^ 4 = 1) (h02 : (f 0 * f 2) ^ 2 = 1)
    (h03 : (f 0 * f 3) ^ 2 = 1) (h13 : (f 1 * f 3) ^ 2 = 1)
    (ht : (f 0 * f 1 * f 2 * f 1) ^ s = 1)
    (hv : (f 1 * f 2 * f 3 * f 2) ^ u = 1) : G s u →* H :=
  PresentedGroup.toGroup (by
    intro w hw
    rcases hw with ⟨i, rfl⟩ | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · simpa using hi i
    · simpa using h01
    · simpa using h12
    · simpa using h23
    · simpa using h02
    · simpa using h03
    · simpa using h13
    · simpa using ht
    · simpa using hv)

@[simp] lemma toGroup_r (s u : ℕ) (f : Fin 4 → H)
    (hi h01 h12 h23 h02 h03 h13 ht hv) (i : Fin 4) :
    toGroup s u f hi h01 h12 h23 h02 h03 h13 ht hv (r s u i) = f i :=
  PresentedGroup.toGroup.of _

end Maps

/-- The facet toroid maps onto the subgroup generated by r₀,r₁,r₂. -/
def facetMap (s u : ℕ) : Toroid.G s →* G s u :=
  let h := relations s u
  Toroid.toGroup s (fun i => r s u i.castSucc) (fun i => h.1 i.castSucc)
    h.2.1 h.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.2.2.1

/-- The vertex toroid maps onto the subgroup generated by r₁,r₂,r₃. -/
def vertexMap (s u : ℕ) : Toroid.G u →* G s u :=
  let h := relations s u
  Toroid.toGroup u (fun i => r s u i.succ) (fun i => h.1 i.succ)
    h.2.2.1 h.2.2.2.1 h.2.2.2.2.2.2.1 h.2.2.2.2.2.2.2.2

@[simp] lemma facetMap_r (s u : ℕ) (i : Fin 3) :
    facetMap s u (Toroid.r s i) = r s u i.castSucc := by simp [facetMap]

@[simp] lemma vertexMap_r (s u : ℕ) (i : Fin 3) :
    vertexMap s u (Toroid.r u i) = r s u i.succ := by simp [vertexMap]

lemma facetMap_range (s u : ℕ) :
    (facetMap s u).range = Subgroup.closure {r s u 0, r s u 1, r s u 2} := by
  simpa using Toroid.range_eq s (facetMap s u)

lemma vertexMap_range (s u : ℕ) :
    (vertexMap s u).range = Subgroup.closure {r s u 1, r s u 2, r s u 3} := by
  simpa using Toroid.range_eq u (vertexMap s u)

section Faithfulness
variable {H : Type*} [Group H] {s u : ℕ}

/-- Faithfulness of a local realization transfers through the universal quotient. -/
lemma facetMap_injective (π : G s u →* H) (f : Fin 4 → H)
    (hπ : ∀ i, π (r s u i) = f i)
    (hf : ToroidRealization s (fun i => f i.castSucc)) :
    Function.Injective (facetMap s u) := by
  obtain ⟨φ, hφ, hinj, _⟩ := hf
  have he : π.comp (facetMap s u) = φ := by
    apply PresentedGroup.ext
    intro i
    change π (facetMap s u (Toroid.r s i)) = φ (Toroid.r s i)
    rw [facetMap_r, hπ, hφ]
  intro a b hab
  apply hinj
  have h := congrArg π hab
  simpa only [← MonoidHom.comp_apply, he] using h

lemma vertexMap_injective (π : G s u →* H) (f : Fin 4 → H)
    (hπ : ∀ i, π (r s u i) = f i)
    (hf : ToroidRealization u (fun i => f i.succ)) :
    Function.Injective (vertexMap s u) := by
  obtain ⟨φ, hφ, hinj, _⟩ := hf
  have he : π.comp (vertexMap s u) = φ := by
    apply PresentedGroup.ext
    intro i
    change π (vertexMap s u (Toroid.r u i)) = φ (Toroid.r u i)
    rw [vertexMap_r, hπ, hφ]
  intro a b hab
  apply hinj
  have h := congrArg π hab
  simpa only [← MonoidHom.comp_apply, he] using h

/-- The facet is the stated toroid, by an equivalence sending generators to generators. -/
noncomputable def facetEquiv (h : Function.Injective (facetMap s u)) :
    Toroid.G s ≃* Subgroup.closure {r s u 0, r s u 1, r s u 2} :=
  (MonoidHom.ofInjective h).trans (MulEquiv.subgroupCongr (facetMap_range s u))

noncomputable def vertexEquiv (h : Function.Injective (vertexMap s u)) :
    Toroid.G u ≃* Subgroup.closure {r s u 1, r s u 2, r s u 3} :=
  (MonoidHom.ofInjective h).trans (MulEquiv.subgroupCongr (vertexMap_range s u))

@[simp] lemma facetEquiv_r (h : Function.Injective (facetMap s u)) (i : Fin 3) :
    (facetEquiv h (Toroid.r s i) : G s u) = r s u i.castSucc := by
  simp [facetEquiv, MonoidHom.ofInjective_apply]

@[simp] lemma vertexEquiv_r (h : Function.Injective (vertexMap s u)) (i : Fin 3) :
    (vertexEquiv h (Toroid.r u i) : G s u) = r s u i.succ := by
  simp [vertexEquiv, MonoidHom.ofInjective_apply]

end Faithfulness
section MatrixBridge
variable {K : Type*} [Field K] [CharP K 2]

/-- The matrix core satisfies every defining relator of Γ(s,u). -/
def coreMap (g : Fin 4 → (Mat K)ˣ) (s u : ℕ) (hcore : CoreConclusion g s u) :
    G s u →* (Mat K)ˣ :=
  toGroup s u g hcore.1
    (by simpa only [hcore.2.1] using pow_orderOf_eq_one (g 0 * g 1))
    (by simpa only [hcore.2.2.1] using pow_orderOf_eq_one (g 1 * g 2))
    (by simpa only [hcore.2.2.2.1] using pow_orderOf_eq_one (g 2 * g 3))
    hcore.2.2.2.2.1 hcore.2.2.2.2.2.1 hcore.2.2.2.2.2.2.1
    (by rw [← hcore.2.2.2.2.2.2.2.1]; exact pow_orderOf_eq_one _)
    (by rw [← hcore.2.2.2.2.2.2.2.2.1]; exact pow_orderOf_eq_one _)

@[simp] lemma coreMap_r (g : Fin 4 → (Mat K)ˣ) (s u : ℕ)
    (hcore : CoreConclusion g s u) (i : Fin 4) :
    coreMap g s u hcore (r s u i) = g i := by simp [coreMap]

/-- Both abstract local maps are faithful, by their composites to the matrices. -/
lemma local_maps_injective (g : Fin 4 → (Mat K)ˣ) (s u : ℕ)
    (hs : 0 < s) (hu : 0 < u) (hcore : CoreConclusion g s u) :
    Function.Injective (facetMap s u) ∧ Function.Injective (vertexMap s u) := by
  obtain ⟨hf, hv⟩ := toroid_realizations g s u hs hu hcore
  exact ⟨facetMap_injective (coreMap g s u hcore) g (coreMap_r g s u hcore) hf,
    vertexMap_injective (coreMap g s u hcore) g (coreMap_r g s u hcore) hv⟩

/-- The quotient to matrices is injective on the entire abstract facet subgroup. -/
lemma coreMap_injOn_facet (g : Fin 4 → (Mat K)ˣ) (s u : ℕ)
    (hs : 0 < s) (hu : 0 < u) (hcore : CoreConclusion g s u) :
    Set.InjOn (coreMap g s u hcore)
      (Subgroup.closure {r s u 0, r s u 1, r s u 2}) := by
  obtain ⟨⟨φ, hφ, hinj, _⟩, _⟩ := toroid_realizations g s u hs hu hcore
  have he : (coreMap g s u hcore).comp (facetMap s u) = φ := by
    apply PresentedGroup.ext
    intro i
    change coreMap g s u hcore (facetMap s u (Toroid.r s i)) = φ (Toroid.r s i)
    rw [facetMap_r, coreMap_r, hφ]
  intro x hx y hy hxy
  rw [← facetMap_range] at hx hy
  obtain ⟨a, rfl⟩ := hx
  obtain ⟨b, rfl⟩ := hy
  have hab : φ a = φ b := by
    simpa only [← MonoidHom.comp_apply, he] using hxy
  rw [hinj hab]

/-- The quotient to matrices is injective on the entire abstract vertex subgroup. -/
lemma coreMap_injOn_vertex (g : Fin 4 → (Mat K)ˣ) (s u : ℕ)
    (hs : 0 < s) (hu : 0 < u) (hcore : CoreConclusion g s u) :
    Set.InjOn (coreMap g s u hcore)
      (Subgroup.closure {r s u 1, r s u 2, r s u 3}) := by
  obtain ⟨_, ⟨φ, hφ, hinj, _⟩⟩ := toroid_realizations g s u hs hu hcore
  have he : (coreMap g s u hcore).comp (vertexMap s u) = φ := by
    apply PresentedGroup.ext
    intro i
    change coreMap g s u hcore (vertexMap s u (Toroid.r u i)) = φ (Toroid.r u i)
    rw [vertexMap_r, coreMap_r, hφ]
  intro x hx y hy hxy
  rw [← vertexMap_range] at hx hy
  obtain ⟨a, rfl⟩ := hx
  obtain ⟨b, rfl⟩ := hy
  have hab : φ a = φ b := by
    simpa only [← MonoidHom.comp_apply, he] using hxy
  rw [hinj hab]

/-- Exact cardinalities of both abstract parabolic subgroups. -/
lemma local_cards (g : Fin 4 → (Mat K)ˣ) (s u : ℕ)
    (hs : 0 < s) (hu : 0 < u) (hcore : CoreConclusion g s u) :
    Nat.card (Subgroup.closure {r s u 0, r s u 1, r s u 2}) = 8 * s ^ 2 ∧
    Nat.card (Subgroup.closure {r s u 1, r s u 2, r s u 3}) = 8 * u ^ 2 := by
  obtain ⟨hf, hv⟩ := toroid_realizations g s u hs hu hcore
  obtain ⟨hfi, hvi⟩ := local_maps_injective g s u hs hu hcore
  obtain ⟨φ, _, hφi, hφr⟩ := hf
  obtain ⟨ψ, _, hψi, hψr⟩ := hv
  constructor
  · calc
      Nat.card (Subgroup.closure {r s u 0, r s u 1, r s u 2}) =
          Nat.card (Toroid.G s) := Nat.card_congr (facetEquiv hfi).symm.toEquiv
      _ = Nat.card φ.range := Nat.card_congr (MonoidHom.ofInjective hφi).toEquiv
      _ = 8 * s ^ 2 := by rw [hφr]; exact hcore.2.2.2.2.2.2.2.2.2.1
  · calc
      Nat.card (Subgroup.closure {r s u 1, r s u 2, r s u 3}) =
          Nat.card (Toroid.G u) := Nat.card_congr (vertexEquiv hvi).symm.toEquiv
      _ = Nat.card ψ.range := Nat.card_congr (MonoidHom.ofInjective hψi).toEquiv
      _ = 8 * u ^ 2 := by rw [hψr]; exact hcore.2.2.2.2.2.2.2.2.2.2.1

end MatrixBridge
end P16c.Universal
