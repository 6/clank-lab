import Uniform5.CompositionFacetSystem

/-!
# Generic finite-polytope incidence laws for Case B vertex figures

The vertex figure of a uniform polytope need not itself be uniform.
These constructions use only finite convexity and actual intrinsic dimension.
-/

noncomputable section
namespace Uniform5.Composition
open Set Classical

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- A genuine extreme apex admits a continuous linear height at least one
on every other generator. -/
theorem finiteHull_exists_cutHeight (V : Finset E)
    (hzero : (0 : E) ∈ (convexHull ℝ (V : Set E)).extremePoints ℝ) :
    ∃ L : E →L[ℝ] ℝ, ∀ x ∈ V.erase 0, 1 ≤ L x := by
  obtain ⟨M, hM⟩ := finite_extreme_strict_support V hzero
  let N : E →L[ℝ] ℝ := -M
  have hN : ∀ x ∈ V.erase 0, 0 < N x := by
    intro x hx
    have hh := hM x (Finset.mem_erase.mp hx).2 (Finset.mem_erase.mp hx).1
    change 0 < -M x
    exact neg_pos.mpr (by simpa using hh)
  by_cases hne : (V.erase 0).Nonempty
  · let m := (V.erase 0).inf' hne (fun x => N x)
    have hm : 0 < m := (Finset.lt_inf'_iff hne).mpr hN
    refine ⟨m⁻¹ • N, ?_⟩
    intro x hx
    have hmin : m ≤ N x := Finset.inf'_le _ hx
    change 1 ≤ m⁻¹ * N x
    rw [mul_comm, ← div_eq_mul_inv]
    exact (one_le_div hm).mpr hmin
  · refine ⟨0, ?_⟩
    intro x hx
    exact False.elim (hne ⟨x, hx⟩)

/-- An arbitrary finite-polytope section is generated by radial projections
of actual edge neighbors; no equal edge lengths or cosphericity is needed. -/
theorem finiteHull_section_eq_radialNeighbours
    (V : Finset E) (hzero : 0 ∈ V)
    (hvertices : ∀ x ∈ V, x ∈ (convexHull ℝ (V : Set E)).extremePoints ℝ)
    (L : E →L[ℝ] ℝ) (hheight : ∀ x ∈ V.erase 0, 1 ≤ L x) :
    heightSection (convexHull ℝ (V : Set E)) L =
      convexHull ℝ (((zeroNeighbors V).image (radialPoint L)) : Set E) := by
  let B := (V.erase 0).image (radialPoint L)
  have hs : heightSection (convexHull ℝ (V : Set E)) L = convexHull ℝ (B : Set E) := by
    simpa only [B, Finset.coe_image, radialPoint] using finiteHull_radial_section V hzero L hheight
  have hcompact : IsCompact (convexHull ℝ (B : Set E)) := B.finite_toSet.isCompact_convexHull
  have hfinite : ((convexHull ℝ (B : Set E)).extremePoints ℝ).Finite :=
    B.finite_toSet.subset extremePoints_convexHull_subset
  have hh : convexHull ℝ (B : Set E) =
      convexHull ℝ ((convexHull ℝ (B : Set E)).extremePoints ℝ) := by
    have hk := closure_convexHull_extremePoints hcompact (convex_convexHull ℝ (B : Set E))
    rw [hfinite.isCompact_convexHull.isClosed.closure_eq] at hk
    exact hk.symm
  rw [hs]
  apply Set.Subset.antisymm
  · conv_lhs => rw [hh]
    apply convexHull_mono
    intro y hy
    obtain ⟨x, _, hxy, he⟩ := radial_extreme_isEdge V hzero hvertices L
      (fun x hx => lt_of_lt_of_le zero_lt_one (hheight x hx)) hy
    exact Finset.mem_image.mpr ⟨x, (mem_zeroNeighbors V x).mpr he, hxy⟩
  · apply convexHull_mono
    intro y hy
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hy
    have he := (mem_zeroNeighbors V x).mp hx
    exact Finset.mem_image.mpr ⟨x, Finset.mem_erase.mpr ⟨he.2.2.1.symm, he.2.1⟩, rfl⟩

/-- Every actual vertex of a positive-dimensional finite polytope has at
least its intrinsic dimension many neighbors. -/
theorem finitePolytope_neighbour_card_lower [FiniteDimensional ℝ E]
    {P : Set E} (hP : FinitePolytope P) {v : E} (hv : v ∈ P.extremePoints ℝ)
    (hpos : 0 < affineDimension P) :
    affineDimension P ≤ (geometricNeighbours P hP v).card := by
  have zero_case {Q : Set E} (hQ : FinitePolytope Q)
      (hz : (0 : E) ∈ Q.extremePoints ℝ) (hd : 0 < affineDimension Q) :
      affineDimension Q ≤ (geometricNeighbours Q hQ 0).card := by
    let V := vertices Q hQ
    have hVzero : (0 : E) ∈ V := (mem_vertices _ 0).mpr hz
    have hVerts : ∀ x ∈ V, x ∈ (convexHull ℝ (V : Set E)).extremePoints ℝ := by
      intro x hx
      simpa only [V, convexHull_vertices] using (mem_vertices hQ x).mp hx
    obtain ⟨L, hL⟩ := finiteHull_exists_cutHeight V (hVerts 0 hVzero)
    have hd' := finiteHull_heightSection_dimension V hVzero L hL (by
      simpa only [V, convexHull_vertices] using hd)
    rw [finiteHull_section_eq_radialNeighbours V hVzero hVerts L hL] at hd'
    have hBne : ((zeroNeighbors V).image (radialPoint L)).Nonempty :=
      (convexHull_nonempty_iff (𝕜 := ℝ)).mp hd'.1
    have hb := finiteHull_dimension_add_one_le_card _ hBne
    have hcard := Finset.card_image_le (s := zeroNeighbors V) (f := radialPoint L)
    rw [hd'.2] at hb
    rw [geometricNeighbours_zero]
    simpa only [V, convexHull_vertices] using hb.trans hcard
  let g := AffineIsometryEquiv.constVAdd ℝ E (-v)
  have hgv : g v = 0 := by simp [g]
  have hz : (0 : E) ∈ (g '' P).extremePoints ℝ := by
    rw [← affineIsometry_image_extremePoints, ← hgv]
    exact mem_image_of_mem g hv
  have hc := zero_case (finitePolytope_image g hP) hz (by simpa using hpos)
  rw [affineDimension_image, ← hgv, geometricNeighbours_image,
    Finset.card_image_of_injective _ g.injective] at hc
  exact hc

/-- Radial normalization bijects actual neighbor labels with their projected
points; different extreme vertices cannot share a positive apex ray. -/
noncomputable def radialNeighbourEquiv
    (V : Finset E) (hzero : 0 ∈ V)
    (hvertices : ∀ x ∈ V, x ∈ (convexHull ℝ (V : Set E)).extremePoints ℝ)
    (L : E →L[ℝ] ℝ) (hheight : ∀ x ∈ V.erase 0, 1 ≤ L x) :
    zeroNeighbors V ≃ (zeroNeighbors V).image (radialPoint L) :=
  Equiv.ofBijective (fun x => ⟨radialPoint L x, Finset.mem_image.mpr ⟨x, x.property, rfl⟩⟩) (by
    constructor
    · intro x y h
      apply Subtype.ext
      apply radialPoint_injOn V hzero hvertices L
        (fun z hz => lt_of_lt_of_le zero_lt_one (hheight z hz))
      · have he := (mem_zeroNeighbors V x).mp x.property
        exact Finset.mem_erase.mpr ⟨he.2.2.1.symm, he.2.1⟩
      · have he := (mem_zeroNeighbors V y).mp y.property
        exact Finset.mem_erase.mpr ⟨he.2.2.1.symm, he.2.1⟩
      · exact congrArg Subtype.val h
    · intro y
      obtain ⟨x, hx, hxy⟩ := Finset.mem_image.mp y.property
      exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩)

/-- The projected neighbors at an arbitrary simple four-dimensional apex
are a genuine three-simplex, even with unequal edge lengths. -/
theorem radialNeighbours_affineIndependent [FiniteDimensional ℝ E]
    (V : Finset E) (hzero : 0 ∈ V)
    (hvertices : ∀ x ∈ V, x ∈ (convexHull ℝ (V : Set E)).extremePoints ℝ)
    (L : E →L[ℝ] ℝ) (hheight : ∀ x ∈ V.erase 0, 1 ≤ L x)
    (hdim : affineDimension (convexHull ℝ (V : Set E)) = 4)
    (hfour : (zeroNeighbors V).card = 4) :
    AffineIndependent ℝ ((↑) : (zeroNeighbors V).image (radialPoint L) → E) := by
  have hc := Fintype.card_congr (radialNeighbourEquiv V hzero hvertices L hheight)
  simp only [Fintype.card_coe] at hc
  have hd := finiteHull_heightSection_dimension V hzero L hheight (by omega)
  rw [finiteHull_section_eq_radialNeighbours V hzero hvertices L hheight, hdim] at hd
  exact affineIndependent_of_card_dimension _ 3 (by omega) (by omega)

/-- The actual simple-vertex lattice of any four-dimensional finite hull.
There is no uniformity or equal-edge-length assumption. -/
noncomputable def finiteHull_simpleVertexFaceLattice [FiniteDimensional ℝ E]
    (V : Finset E) (hzero : 0 ∈ V)
    (hvertices : ∀ x ∈ V, x ∈ (convexHull ℝ (V : Set E)).extremePoints ℝ)
    (L : E →L[ℝ] ℝ) (hheight : ∀ x ∈ V.erase 0, 1 ≤ L x)
    (hdim : affineDimension (convexHull ℝ (V : Set E)) = 4)
    (hfour : (zeroNeighbors V).card = 4) :
    VertexFigureSimplexFaceLattice (apexNeighborsIn V) := by
  let B := (zeroNeighbors V).image (radialPoint L)
  let eN := radialNeighbourEquiv V hzero hvertices L hheight
  have hsection : heightSection (convexHull ℝ (V : Set E)) L = convexHull ℝ (B : Set E) :=
    finiteHull_section_eq_radialNeighbours V hzero hvertices L hheight
  have hBi := radialNeighbours_affineIndependent V hzero hvertices L hheight hdim hfour
  let eG := (geometricFace_congr hsection).trans (simplexFaceEquiv B hBi)
  refine ⟨((apexFaceSectionEquiv V hzero L hheight).trans eG).trans
    (finsetLabelEquiv eN.symm), ?_⟩
  intro F
  have he (G : GeometricFace (heightSection (convexHull ℝ (V : Set E)) L)) (b : B) :
      b ∈ eG G ↔ (b : E) ∈ G.val := mem_simplexVerticesIn _ _ _
  ext x
  change x ∈ (eG (apexFaceSectionEquiv V hzero L hheight F)).map eN.symm.toEmbedding ↔ _
  rw [Finset.mem_map, mem_apexNeighborsIn]
  have hxedge := (mem_zeroNeighbors V (x : E)).mp x.property
  have hxV : (x : E) ∈ V.erase 0 := Finset.mem_erase.mpr ⟨hxedge.2.2.1.symm, hxedge.2.1⟩
  have hxP := subset_convexHull ℝ (V : Set E) hxedge.2.1
  constructor
  · rintro ⟨b, hb, hbx⟩
    rw [he, apexFaceSectionEquiv_apply] at hb
    have hrad : radialPoint L (x : E) = (b : E) := by
      have hh := congrArg Subtype.val (eN.apply_symm_apply b)
      change radialPoint L (eN.symm b : E) = (b : E) at hh
      change eN.symm b = x at hbx
      rw [hbx] at hh
      exact hh
    exact (radialPoint_mem_face_iff F.val.property F.property L hxP (hheight x hxV)).mp
      (hrad.symm ▸ hb.1)
  · intro hxF
    refine ⟨eN x, ?_, eN.symm_apply_apply x⟩
    rw [he, apexFaceSectionEquiv_apply]
    have hrF := (radialPoint_mem_face_iff F.val.property F.property L hxP (hheight x hxV)).mpr hxF
    exact ⟨hrF, F.val.property.2.1 hrF,
      linear_radialPoint L (ne_of_gt (lt_of_lt_of_le zero_lt_one (hheight x hxV)))⟩

/-- At any simple four-dimensional apex, face dimension is exactly the
number of incident edges. -/
theorem finiteHull_simpleVertex_face_dimension [FiniteDimensional ℝ E]
    (V : Finset E) (hzero : 0 ∈ V)
    (hvertices : ∀ x ∈ V, x ∈ (convexHull ℝ (V : Set E)).extremePoints ℝ)
    (L : E →L[ℝ] ℝ) (hheight : ∀ x ∈ V.erase 0, 1 ≤ L x)
    (hdim : affineDimension (convexHull ℝ (V : Set E)) = 4)
    (hfour : (zeroNeighbors V).card = 4)
    (F : FacesAt (convexHull ℝ (V : Set E)) 0) :
    affineDimension F.val.val = (apexNeighborsIn V F).card := by
  by_cases hF0 : F.val.val = {0}
  · have hinc : apexNeighborsIn V F = ∅ := by
      apply Finset.eq_empty_iff_forall_not_mem.mpr
      intro x hx
      have hx0 : (x : E) = 0 := by simpa [hF0] using (mem_apexNeighborsIn V F x).mp hx
      exact ((mem_zeroNeighbors V (x : E)).mp x.property).2.2.1 hx0.symm
    rw [hF0, affineDimension_singleton, hinc, Finset.card_empty]
  let B := (zeroNeighbors V).image (radialPoint L)
  let eN := radialNeighbourEquiv V hzero hvertices L hheight
  have hsection : heightSection (convexHull ℝ (V : Set E)) L = convexHull ℝ (B : Set E) :=
    finiteHull_section_eq_radialNeighbours V hzero hvertices L hheight
  have hBi := radialNeighbours_affineIndependent V hzero hvertices L hheight hdim hfour
  let G := geometricFace_congr hsection (apexFaceSectionEquiv V hzero L hheight F)
  have hGne : G.val.Nonempty :=
    (apexFace_section_nonempty_iff V L hheight F.val.property F.property).mpr hF0
  have hinc : (simplexVerticesIn B G).map eN.symm.toEmbedding = apexNeighborsIn V F :=
    (finiteHull_simpleVertexFaceLattice V hzero hvertices L hheight hdim hfour).incidence F
  have hc := congrArg Finset.card hinc
  rw [Finset.card_map] at hc
  have hdG := simplexFace_dimension B hBi G hGne
  have hdF := apexFace_section_dimension V hzero L hheight F.val.property F.property hF0
  exact hdF.symm.trans (hdG.trans hc)

theorem finiteHull_simpleVertex_facet_iff_three [FiniteDimensional ℝ E]
    (V : Finset E) (hzero : 0 ∈ V)
    (hvertices : ∀ x ∈ V, x ∈ (convexHull ℝ (V : Set E)).extremePoints ℝ)
    (L : E →L[ℝ] ℝ) (hheight : ∀ x ∈ V.erase 0, 1 ≤ L x)
    (hdim : affineDimension (convexHull ℝ (V : Set E)) = 4)
    (hfour : (zeroNeighbors V).card = 4)
    (F : FacesAt (convexHull ℝ (V : Set E)) 0) :
    Facet (convexHull ℝ (V : Set E)) F.val.val ↔ (apexNeighborsIn V F).card = 3 := by
  have hdF := finiteHull_simpleVertex_face_dimension V hzero hvertices L hheight hdim hfour F
  constructor
  · intro hf
    have hr := hf.2.2
    omega
  · intro hc
    exact ⟨F.val.property, ⟨0, F.property⟩, by omega⟩

/-- The geometric simple-vertex lattice at zero for an arbitrary finite
four-polytope. The cutting functional is constructed, not a hypothesis. -/
noncomputable def finitePolytope_zeroSimpleVertexFaceLattice [FiniteDimensional ℝ E]
    {P : Set E} (hP : FinitePolytope P) (hdim : affineDimension P = 4)
    (hzero : (0 : E) ∈ P.extremePoints ℝ) (hfour : (zeroNeighbors (vertices P hP)).card = 4) :
    VertexFigureSimplexFaceLattice (apexNeighborsIn (vertices P hP)) := by
  apply Classical.choice
  let V := vertices P hP
  have hVzero : (0 : E) ∈ V := (mem_vertices _ 0).mpr hzero
  have hVerts : ∀ x ∈ V, x ∈ (convexHull ℝ (V : Set E)).extremePoints ℝ := by
    intro x hx
    simpa only [V, convexHull_vertices] using (mem_vertices hP x).mp hx
  obtain ⟨L, hL⟩ := finiteHull_exists_cutHeight V (hVerts 0 hVzero)
  exact ⟨finiteHull_simpleVertexFaceLattice V hVzero hVerts L hL
    (by simpa only [V, convexHull_vertices] using hdim) hfour⟩

theorem finitePolytope_zeroSimpleVertex_facet_iff_three [FiniteDimensional ℝ E]
    {P : Set E} (hP : FinitePolytope P) (hdim : affineDimension P = 4)
    (hzero : (0 : E) ∈ P.extremePoints ℝ) (hfour : (zeroNeighbors (vertices P hP)).card = 4)
    (F : FacesAt (convexHull ℝ (vertices P hP : Set E)) 0) :
    Facet P F.val.val ↔ (apexNeighborsIn (vertices P hP) F).card = 3 := by
  let V := vertices P hP
  have hVzero : (0 : E) ∈ V := (mem_vertices _ 0).mpr hzero
  have hVerts : ∀ x ∈ V, x ∈ (convexHull ℝ (V : Set E)).extremePoints ℝ := by
    intro x hx
    simpa only [V, convexHull_vertices] using (mem_vertices hP x).mp hx
  obtain ⟨L, hL⟩ := finiteHull_exists_cutHeight V (hVerts 0 hVzero)
  have hf := finiteHull_simpleVertex_facet_iff_three V hVzero hVerts L hL
    (by simpa only [V, convexHull_vertices] using hdim) hfour F
  simpa only [V, convexHull_vertices] using hf

/-- The genuine simplex face lattice at any degree-four vertex of a
finite four-polytope. Translation removes the origin restriction. -/
noncomputable def finitePolytope_simpleVertexFaceLattice [FiniteDimensional ℝ E]
    {P : Set E} (hP : FinitePolytope P) (hdim : affineDimension P = 4) {v : E} (hv : v ∈ P.extremePoints ℝ)
    (hfour : (geometricNeighbours P hP v).card = 4) :
    VertexFigureSimplexFaceLattice
      (neighboursIn P hP v) := by
  let g := AffineIsometryEquiv.constVAdd ℝ E (-v)
  have hgv : g v = 0 := by simp [g]
  let hQ := finitePolytope_image g hP
  have hz : (0 : E) ∈ (g '' P).extremePoints ℝ := by
    rw [← affineIsometry_image_extremePoints, ← hgv]
    exact mem_image_of_mem g hv
  let V := vertices (g '' P) hQ
  let eN := zeroNeighbourImageEquiv g P hP v hgv
  have hfourQ : (zeroNeighbors V).card = 4 := by
    have hc := Fintype.card_congr eN
    simp only [Fintype.card_coe] at hc
    exact hc.trans hfour
  let hl := finitePolytope_zeroSimpleVertexFaceLattice hQ (by simpa using hdim) hz hfourQ
  let eF : FacesAt P v ≃o FacesAt (convexHull ℝ (V : Set E)) 0 :=
    (facesAtImageEquiv g P v).trans (facesAtCongr (convexHull_vertices hQ).symm hgv)
  refine ⟨(eF.trans hl.faceEquiv).trans (finsetLabelEquiv eN), ?_⟩
  intro F
  ext x
  change x ∈ (hl.faceEquiv (eF F)).map eN.toEmbedding ↔
    x ∈ neighboursIn P hP v F
  rw [Finset.mem_map, mem_neighboursIn]
  constructor
  · rintro ⟨y, hy, hyx⟩
    rw [hl.incidence, mem_apexNeighborsIn] at hy
    change (y : E) ∈ g '' F.val.val at hy
    obtain ⟨z, hzF, hzy⟩ := hy
    have hcoe : g.symm (y : E) = (x : E) := congrArg Subtype.val hyx
    have hxz : (x : E) = z := by rw [← hcoe, ← hzy, g.symm_apply_apply]
    exact hxz.symm ▸ hzF
  · intro hxF
    refine ⟨eN.symm x, ?_, eN.apply_symm_apply x⟩
    rw [hl.incidence, mem_apexNeighborsIn]
    exact mem_image_of_mem g hxF

/-- An actual facet at any degree-four vertex has exactly three incident
edges, without an origin or assumed face-lattice premise. -/
theorem finitePolytope_simpleVertex_facet_iff_three [FiniteDimensional ℝ E]
    {P : Set E} (hP : FinitePolytope P) (hdim : affineDimension P = 4) {v : E} (hv : v ∈ P.extremePoints ℝ)
    (hfour : (geometricNeighbours P hP v).card = 4)
    (F : FacesAt P v) :
    Facet P F.val.val ↔ (neighboursIn P hP v F).card = 3 := by
  let g := AffineIsometryEquiv.constVAdd ℝ E (-v)
  have hgv : g v = 0 := by simp [g]
  let hQ := finitePolytope_image g hP
  have hz : (0 : E) ∈ (g '' P).extremePoints ℝ := by
    rw [← affineIsometry_image_extremePoints, ← hgv]
    exact mem_image_of_mem g hv
  let V := vertices (g '' P) hQ
  let eN := zeroNeighbourImageEquiv g P hP v hgv
  have hfourQ : (zeroNeighbors V).card = 4 := by
    have hc := Fintype.card_congr eN
    simp only [Fintype.card_coe] at hc
    exact hc.trans hfour
  let G := zeroFacesImageEquiv g P hP v hgv F
  have hf := finitePolytope_zeroSimpleVertex_facet_iff_three hQ (by simpa using hdim) hz hfourQ G
  have hi := congrArg Finset.card
    (zeroNeighbourImage_incidence g P hP v hgv F)
  rw [Finset.card_map] at hi
  rw [hi] at hf
  exact (facet_image_iff g P F.val.val).symm.trans hf

/-- Every three incident edges at an arbitrary simple vertex determine
exactly one actual facet through that vertex. -/
theorem finitePolytope_simpleVertex_unique_facet [FiniteDimensional ℝ E]
    {P : Set E} (hP : FinitePolytope P) (hdim : affineDimension P = 4) {v : E} (hv : v ∈ P.extremePoints ℝ)
    (hfour : (geometricNeighbours P hP v).card = 4)
    (s : Finset (geometricNeighbours P hP v)) (hthree : s.card = 3) :
    ∃! F : FacesAt P v, Facet P F.val.val ∧ neighboursIn P hP v F = s := by
  let hl := finitePolytope_simpleVertexFaceLattice hP hdim hv hfour
  have hi : neighboursIn P hP v (hl.faceEquiv.symm s) = s := by
    rw [← hl.incidence, hl.faceEquiv.apply_symm_apply]
  refine ⟨hl.faceEquiv.symm s, ⟨?_, hi⟩, ?_⟩
  · apply (finitePolytope_simpleVertex_facet_iff_three hP hdim hv hfour _).mpr
    rw [hi, hthree]
  · intro F hF
    apply hl.faceEquiv.injective
    rw [hl.incidence, hF.2, hl.faceEquiv.apply_symm_apply]

/-- The three generic Case B incidence laws hold for the actual vertices
and facets of every finite four-dimensional polytope. All geometric prerequisites
are derived, including minimum facet degree and the unique-three principle. -/
theorem actualFacetSystem_general_laws [FiniteDimensional ℝ E]
    {P : Set E} (hP : FinitePolytope P) (hdim : affineDimension P = 4) :
    (actualFacetSystem P hP).Laws := by
  let hpoly := hP
  constructor
  · intro F v hv
    have hvF := (mem_actualFacetSystem_vertices P hpoly F v).mp hv
    have hFP := finitePolytope_facet hP F.property
    have hdimF : affineDimension F.val = 3 := by
      have hh := F.property.2.2
      rw [hdim] at hh
      omega
    have hvext : (v : E) ∈ F.val.extremePoints ℝ := by
      rw [face_extremePoints_eq F.property.1]
      exact ⟨hvF, (mem_vertices hpoly v).mp v.property⟩
    have hc := congrArg Finset.card (actualFacetSystem_facetNeighbours_image P hpoly F v hvF)
    rw [Finset.card_image_of_injective _ Subtype.val_injective] at hc
    rw [hc]
    have hh := finitePolytope_neighbour_card_lower hFP hvext (by omega)
    rwa [hdimF] at hh
  · intro F v hv hfour
    have hvF := (mem_actualFacetSystem_vertices P hpoly F v).mp hv
    have hfour' : (geometricNeighbours P hpoly v).card = 4 := by
      rwa [actualFacetSystem_neighbours_card] at hfour
    have hf := (finitePolytope_simpleVertex_facet_iff_three hP hdim
      ((mem_vertices hpoly v).mp v.property) hfour'
      ⟨⟨F.val, F.property.1⟩, hvF⟩).mp F.property
    rw [actualFacetSystem_facetNeighbours P hpoly F v hvF, Finset.card_map]
    exact hf
  · intro v hfour s hs hthree
    have hfour' : (geometricNeighbours P hpoly v).card = 4 := by
      rwa [actualFacetSystem_neighbours_card] at hfour
    let e := neighbourVertexEmbedding P hpoly (v : E)
    let t : Finset (geometricNeighbours P hpoly v) := Finset.univ.filter (fun w => e w ∈ s)
    have hmap : t.map e = s := by
      ext w
      rw [Finset.mem_map]
      constructor
      · rintro ⟨x, hx, hxw⟩
        have hx' : e x ∈ s := (Finset.mem_filter.mp hx).2
        exact hxw ▸ hx'
      · intro hw
        have hneigh := hs hw
        rw [actualFacetSystem_neighbours, Finset.mem_map] at hneigh
        obtain ⟨x, _, hxw⟩ := hneigh
        exact ⟨x, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxw.symm ▸ hw⟩, hxw⟩
    have hcardt : t.card = 3 := by
      have hc := congrArg Finset.card hmap
      rw [Finset.card_map, hthree] at hc
      exact hc
    obtain ⟨F, ⟨hF, hinc⟩, _⟩ := finitePolytope_simpleVertex_unique_facet hP hdim
      ((mem_vertices hpoly v).mp v.property) hfour' t hcardt
    let f : {F : Set E // Facet P F} := ⟨F.val.val, hF⟩
    refine ⟨f, (mem_actualFacetSystem_vertices P hpoly f v).mpr F.property, ?_⟩
    rw [actualFacetSystem_facetNeighbours P hpoly f v F.property]
    change (neighboursIn P hpoly v F).map e = s
    rw [hinc, hmap]

/-- A positive-dimensional cospherical unit-edge polytope has a genuine
nonempty finite vertex figure; neighbor existence is derived from dimension. -/
theorem finitePolytope_vertexFigure_of_positiveDimension [FiniteDimensional ℝ E]
    {P : Set E} (hP : FinitePolytope P) {v : E} (hv : v ∈ P.extremePoints ℝ)
    (c : E) (R : ℝ) (hs : ∀ x ∈ P.extremePoints ℝ, ‖x - c‖ ^ 2 = R ^ 2)
    (hunit : UnitEdges P) (hpos : 0 < affineDimension P) :
    FinitePolytope (vertexFigure P v c) := by
  have hc := finitePolytope_neighbour_card_lower hP hv hpos
  obtain ⟨w, hw⟩ := Finset.card_pos.mp (show 0 < (geometricNeighbours P hP v).card by omega)
  exact finitePolytope_vertexFigure hP hv c R hs hunit
    ⟨w, (mem_geometricNeighbours P hP v w).mp hw⟩

noncomputable local instance : DecidableEq (Space 5) := Classical.decEq _

/-- The actual vertex figures of a unit-uniform five-polytope carry the
Case B incidence systems and all their laws, with no uniformity assumption
on those vertex figures. -/
theorem unitUniform5_actualVertexFigureSystems {P : Set (Space 5)} (hP : UnitUniform 5 P) :
    ∃ c : Space 5, ∃ R : ℝ, 0 < R ∧
      (∀ x ∈ P.extremePoints ℝ, ‖x - c‖ ^ 2 = R ^ 2) ∧
      ∀ v ∈ P.extremePoints ℝ,
        ∃ hQ : FinitePolytope (vertexFigure P v c),
          affineDimension (vertexFigure P v c) = 4 ∧
          (actualFacetSystem (vertexFigure P v c) hQ).Laws := by
  obtain ⟨c, R, hR, hs, hfig⟩ := unitUniform5_vertexFigures hP
  refine ⟨c, R, hR, hs, ?_⟩
  intro v hv
  have hQ := finitePolytope_vertexFigure_of_positiveDimension
    (uniform_finitePolytope hP.1) hv c R hs hP.2 (by rw [uniform_dimension hP.1]; norm_num)
  have hd := (hfig v hv).2.2
  exact ⟨hQ, hd, actualFacetSystem_general_laws hQ hd⟩

end Uniform5.Composition
