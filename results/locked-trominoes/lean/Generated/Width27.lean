    (shiftOwner (9,0) Width27_b1_owner) 9 0 9 27 := by decide +kernel
theorem Width27_vertical_3 : ∀ A B, Width27_b1.tiles A → Width27_b1.tiles B → Rigid A (Shift (9,0) B) := by
  have hp := localSeam_rigid (h := 9) (w := 27)
    (Width27_vertical_3_same.symm ▸ Width27_b1.partition) Width27_b1_partition
    Width27_vertical_3_entries_links Width27_vertical_3_cover
    (side_disjoint 9 27 9 27).1
  rw [Width27_vertical_3_same] at hp
  exact hp

def Width27_palette : VerticalPalette (fun h => h = 6 ∨ h = 9) 27 where
  tiles h := if h = 6 then Width27_b0.tiles else Width27_b1.tiles
  partition := by
    intro h hh
    rcases hh with rfl | rfl
    · exact Width27_b0.partition
    · exact Width27_b1.partition
  internal := by
    intro h hh
    rcases hh with rfl | rfl
    · exact Width27_b0.internal
    · exact Width27_b1.internal
  vertical := by
    intro h k hh hk
    rcases hh with rfl | rfl <;> rcases hk with rfl | rfl
    · exact Width27_vertical_0
    · exact Width27_vertical_1
    · exact Width27_vertical_2
    · exact Width27_vertical_3

