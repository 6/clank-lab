def bern (n : ℕ) (s : ℝ) (j : ℕ) : ℝ := (n.choose j : ℝ) * s^j * (1-s)^(n-j)
def q (t : ℝ) : ℝ := ∑ j : Fin 5, qCoeff j * bern 4 ((t+1)/2) j

theorem weights_nonneg (m : Fin 24) : 0 ≤ weights m := by
  fin_cases m <;> norm_num [weights]
theorem qCoeff_nonneg (j : Fin 5) : 0 ≤ qCoeff j := by
  fin_cases j <;> norm_num [qCoeff]
theorem rCoeff_shift_nonneg (j : Fin 10) : 0 ≤ rCoeff j-rCoeff 0 := by
  fin_cases j <;> norm_num [rCoeff]
theorem bern_nonneg (n j : ℕ) (s : ℝ) (hs : 0 ≤ s) (ht : s ≤ 1) :
    0 ≤ bern n s j := by
  unfold bern
  positivity

theorem minorant_identity (t : ℝ) :
    1-(2-2*t)*h t^2 = (t+1)*(t+17/32)^2*(t-23/72)^2*q t := by
  norm_num [h, q, qCoeff, bern, Fin.sum_univ_succ, Nat.choose]
  ring

theorem residual_identity (t : ℝ) :
    1-(2-2*t)*(h t+51/1000)^2 = rCoeff 0 +
      ∑ j : Fin 10, (rCoeff j-rCoeff 0)*bern 9 ((20*t-13)/7) j := by
  norm_num [h, rCoeff, bern, Fin.sum_univ_succ, Nat.choose]
  ring

def coordDot (x y : Point) : ℝ := x 0*y 0+x 1*y 1+x 2*y 2
def coordSq (x : Point) : ℝ := (x 0)^2+(x 1)^2+(x 2)^2

theorem harmonic_identity (x y : Point) :
    a0 + ∑ m : Fin 24, weights m * feature m x * feature m y =
    a0 + (833419493024 / 1672307004375 : ℝ)*(coordDot x y) + (1760733078976 / 7023689418375 : ℝ)*((3/2:ℝ)*(coordDot x y)^2-(1/2:ℝ)*(coordSq x * coordSq y)) + (17766191104 / 185811889375 : ℝ)*((5/2:ℝ)*(coordDot x y)^3-(3/2:ℝ)*(coordDot x y)*(coordSq x * coordSq y)) + (5504237568 / 260136645125 : ℝ)*((35/8:ℝ)*(coordDot x y)^4-(30/8:ℝ)*(coordDot x y)^2*(coordSq x * coordSq y)+(3/8:ℝ)*(coordSq x * coordSq y)^2) := by
  norm_num [weights, feature, coordDot, coordSq, Fin.sum_univ_succ]
  ring

theorem legendre_identity (t : ℝ) :
    h t = a0 + (833419493024 / 1672307004375 : ℝ)*t + (1760733078976 / 7023689418375 : ℝ)*((3/2:ℝ)*t^2-1/2) +
