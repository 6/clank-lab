import SpinningSwitches.Sufficiency

/-!
# Classification of solvable generalized spinning-switches puzzles

Answer to Kagey's Open Question 31 (J. Combin. Theory Ser. A 200 (2023), arXiv:2210.09408):
for nontrivial finite `G` and a nontrivial finite group `H` acting faithfully on a finite set
`Ω`, the puzzle `G ≀_Ω H` has a surjective strategy iff `G` and `H` are `p`-groups for one
prime `p`.
-/

namespace SpinningSwitches

variable {G H Ω : Type*} [Group G] [Group H] [MulAction H Ω]

/-- Kagey's Theorem 22, reproved: `p`-group switches against a `p`-group adversary. -/
theorem sufficiency [Finite G] [Finite H] [Finite Ω] {p : ℕ} (hp : p.Prime)
    (hG : IsPGroup p G) (hH : IsPGroup p H) : ∃ ks : List (Ω → G), IsSurjectiveStrategy H ks := by
  have := Fact.mk hp
  obtain ⟨a, ha⟩ := IsPGroup.iff_card.mp hG
  obtain ⟨b, hb⟩ := IsPGroup.iff_card.mp hH
  have hW : IsPGroup p ((Ω → G) ⋊[spin G H Ω] H) := by
    apply IsPGroup.of_card (n := a * Nat.card Ω + b)
    rw [Nat.card_congr SemidirectProduct.equivProd, Nat.card_prod, Nat.card_fun, ha, hb,
      ← pow_mul, ← pow_add]
  obtain ⟨s, hs⟩ := exists_exclH_univ hW
  exact ⟨s, strategy_of_exclH s hs⟩

/-- A surjective strategy forces `G` to be a `q`-group for every prime `q` dividing `|H|`. -/
theorem isPGroup_of_prime_dvd [Finite H] [FaithfulSMul H Ω] {ks : List (Ω → G)}
    (hS : IsSurjectiveStrategy H ks) {q : ℕ} (hq : q.Prime) (hdvd : q ∣ Nat.card H) :
    IsPGroup q G := by
  have := Fact.mk hq
  obtain ⟨h, hh⟩ := exists_prime_orderOf_dvd_card' q hdvd
  have hh1 : h ≠ 1 := by
    rintro rfl; rw [orderOf_one] at hh; exact hq.one_lt.ne hh
  obtain ⟨ω, hω⟩ : ∃ ω : Ω, h • ω ≠ ω := by
    by_contra hcon
    push Not at hcon
    exact hh1 (FaithfulSMul.eq_of_smul_eq_smul fun ω => by rw [hcon ω, one_smul])
  exact isPGroup_of_strategy (ω := ω) hq (by rw [← hh, pow_orderOf_eq_one]) hω ks hS

/-- **Main theorem.** -/
theorem classification [Finite G] [Finite H] [Finite Ω] [FaithfulSMul H Ω]
    [Nontrivial G] [Nontrivial H] :
    (∃ ks : List (Ω → G), IsSurjectiveStrategy H ks) ↔
      ∃ p : ℕ, p.Prime ∧ IsPGroup p G ∧ IsPGroup p H := by
  constructor
  · rintro ⟨ks, hS⟩
    have hH1 : Nat.card H ≠ 1 := by
      have := Finite.one_lt_card (α := H); omega
    set p := (Nat.card H).minFac with hp
    have hpp : p.Prime := Nat.minFac_prime hH1
    have hpG := isPGroup_of_prime_dvd hS hpp (Nat.minFac_dvd _)
    refine ⟨p, hpp, hpG, ?_⟩
    have huniq : ∀ {d : ℕ}, d.Prime → d ∣ Nat.card H → d = p := by
      intro d hd hdH
      have hdG := isPGroup_of_prime_dvd hS hd hdH
      have := Fact.mk hd
      have := Fact.mk hpp
      obtain ⟨n, hn0, hn⟩ := hdG.nontrivial_iff_card.mp inferInstance
      obtain ⟨m, hm⟩ := IsPGroup.iff_card.mp hpG
      have : d ∣ p ^ m := by rw [← hm, hn]; exact dvd_pow_self d hn0.ne'
      exact (Nat.prime_dvd_prime_iff_eq hd hpp).mp (hd.dvd_of_dvd_pow this)
    exact IsPGroup.of_card (Nat.eq_prime_pow_of_unique_prime_dvd Nat.card_pos.ne' huniq)
  · rintro ⟨p, hp, hG, hH⟩
    exact sufficiency hp hG hH

/-- Kagey's Theorem 26 and Example 27 fail: two interchangeable `S₃` switches cannot be
solved. -/
theorem S3_wr_C2_unsolvable :
    ¬ ∃ ks : List (Fin 2 → Equiv.Perm (Fin 3)), IsSurjectiveStrategy (Equiv.Perm (Fin 2)) ks := by
  rintro ⟨ks, hS⟩
  have h2 := isPGroup_of_strategy (h := Equiv.swap (0 : Fin 2) 1) (ω := 0) Nat.prime_two
    (by decide) (by decide) ks hS
  have := Fact.mk Nat.prime_three
  have hc : orderOf (finRotate 3) = 3 := orderOf_eq_prime (by decide) (by decide)
  obtain ⟨k, hk⟩ := h2 (finRotate 3)
  have := orderOf_dvd_of_pow_eq_one hk
  rw [hc] at this
  have := Nat.prime_three.dvd_of_dvd_pow this
  omega

/-- Kagey's Conjecture 34 (and Conjecture 33 at `n = 4`) fails: three `A₄` switches on a
triangle cannot be solved, though `A₄` is generated by elements of order 3. -/
theorem A4_wr_C3_unsolvable :
    ¬ ∃ ks : List (Fin 3 → alternatingGroup (Fin 4)),
      IsSurjectiveStrategy (alternatingGroup (Fin 3)) ks := by
  rintro ⟨ks, hS⟩
  let r : alternatingGroup (Fin 3) := ⟨finRotate 3, Equiv.Perm.mem_alternatingGroup.mpr (by decide)⟩
  have h3 := isPGroup_of_strategy (h := r) (ω := 0) Nat.prime_three
    (by decide) (by decide) ks hS
  have := Fact.mk Nat.prime_two
  let g : alternatingGroup (Fin 4) := ⟨Equiv.swap 0 1 * Equiv.swap 2 3, Equiv.Perm.mem_alternatingGroup.mpr (by decide)⟩
  have hg : orderOf g = 2 := orderOf_eq_prime (by decide) (by decide)
  obtain ⟨k, hk⟩ := h3 g
  have := orderOf_dvd_of_pow_eq_one hk
  rw [hg] at this
  have := Nat.prime_two.dvd_of_dvd_pow this
  omega

end SpinningSwitches
