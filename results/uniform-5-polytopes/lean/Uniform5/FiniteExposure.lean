import Uniform5.Separation
import Mathlib.Analysis.NormedSpace.HahnBanach.Separation
import Mathlib.Analysis.Convex.Topology

open Set

namespace Uniform5

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [DecidableEq E]

/-- A generator outside the hull of all other generators is exposed.
This uses strict separation from a compact finite convex hull. -/
theorem finite_generator_exposed (S : Finset E) {x : E} (hx : x ∈ S)
    (hnot : x ∉ convexHull ℝ (↑(S.erase x) : Set E)) :
    x ∈ (convexHull ℝ (S : Set E)).exposedPoints ℝ := by
  classical
  obtain ⟨L, b, hL, hb⟩ := geometric_hahn_banach_closed_point
    (convex_convexHull ℝ _) (S.erase x).finite_toSet.isCompact_convexHull.isClosed hnot
  have hgen : ∀ y ∈ S, L y ≤ L x ∧ (L x ≤ L y → y = x) := by
    intro y hy
    by_cases hyx : y = x
    · simp [hyx]
    · have hh := (hL y (subset_convexHull ℝ _ (Finset.mem_erase.mpr ⟨hyx, hy⟩))).trans hb
      exact ⟨hh.le, fun h => False.elim ((not_le.mpr hh) h)⟩
  rw [exposed_point_def]
  refine ⟨subset_convexHull ℝ _ hx, L, ?_⟩
  have hc : Convex ℝ {y : E | L y ≤ L x ∧ (L x ≤ L y → y = x)} := by
    intro y hy z hz a d ha hd had
    simp only [mem_setOf_eq, map_add, map_smul, smul_eq_mul] at *
    have hadL : a * L x + d * L x = L x := by
      nlinarith [congrArg (fun t : ℝ => t * L x) had]
    refine ⟨by nlinarith [mul_nonneg ha (sub_nonneg.mpr hy.1),
      mul_nonneg hd (sub_nonneg.mpr hz.1)], ?_⟩
    intro he
    by_cases ha0 : a = 0
    · have hd1 : d = 1 := by linarith
      simpa [ha0, hd1] using hz.2 (by simpa [ha0, hd1] using he)
    by_cases hd0 : d = 0
    · have ha1 : a = 1 := by linarith
      simpa [hd0, ha1] using hy.2 (by simpa [hd0, ha1] using he)
    have hyEq : L x ≤ L y := by
      have hp : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
      nlinarith [mul_nonneg hd (sub_nonneg.mpr hz.1)]
    have hzEq : L x ≤ L z := by
      have hp : 0 < d := lt_of_le_of_ne hd (Ne.symm hd0)
      nlinarith [mul_nonneg ha (sub_nonneg.mpr hy.1)]
    rw [hy.2 hyEq, hz.2 hzEq, ← add_smul, had, one_smul]
  exact convexHull_min hgen hc

/-- A finite convex hull is generated by its exposed points. The proof removes
redundant generators and strictly separates each remaining generator; it needs
no unformalized polytope face theorem. -/
theorem finite_convexHull_exposedPoints (S : Finset E) :
    convexHull ℝ ((convexHull ℝ (S : Set E)).exposedPoints ℝ) =
      convexHull ℝ (S : Set E) := by
  classical
  refine Finset.strongInductionOn S ?_
  intro S ih
  by_cases h : ∃ x ∈ S, x ∈ convexHull ℝ (↑(S.erase x) : Set E)
  · obtain ⟨x, hx, hred⟩ := h
    have heq : convexHull ℝ (S : Set E) = convexHull ℝ (↑(S.erase x) : Set E) := by
      apply le_antisymm
      · apply convexHull_min _ (convex_convexHull ℝ _)
        intro y hy
        by_cases hyx : y = x
        · simpa [hyx] using hred
        · exact subset_convexHull ℝ _ (Finset.mem_erase.mpr ⟨hyx, hy⟩)
      · exact convexHull_mono (Finset.coe_subset.mpr (Finset.erase_subset x S))
    rw [heq]
    exact ih (S.erase x) (Finset.erase_ssubset hx)
  · apply le_antisymm (convexHull_min exposedPoints_subset (convex_convexHull ℝ _))
    apply convexHull_mono
    intro x hx
    exact finite_generator_exposed S hx (fun hh => h ⟨x, hx, hh⟩)

end Uniform5
